<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Version>12.1.1</Version>
		<AssemblyVersion>12.1.1</AssemblyVersion>
		<FileVersion>12.1.1</FileVersion>
		<PackageVersion>12.1.1</PackageVersion>
		<Authors>toiyabe62</Authors>
		<Nullable>enable</Nullable>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Cosmos,CosmosDB,MySQL,SQL Server,SQLite,Identity,Provider,AspNetCore,Membership,Roles,AspNetCore.Identity,Microsoft.AspNetCore.Identity,aspnet,efcore,Azure Cosmos DB</PackageTags>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>AspNetCore.Identity.FlexDb</PackageId>
		<RepositoryUrl>https://github.com/CWALabs/SkyCMS</RepositoryUrl>
		<PackageProjectUrl>https://github.com/CWALabs/SkyCMS/tree/main/AspNetCore.Identity.FlexDb</PackageProjectUrl>
		<PackageReadmeFile>NUGET.md</PackageReadmeFile>
		<PackageIcon>B2C_BrandIcon_Black.png</PackageIcon>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Description>An ASP.NET Core Identity provider for Azure Cosmos DB, MySQL, SQL Server, and SQLite with automatic provider selection from the connection string.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<Company>Cosmos Software LLC</Company>
		<Copyright>Moonrise Software LLC</Copyright>
		<PackageReleaseNotes>Correctness fixes, async cleanup, and package metadata updates.</PackageReleaseNotes>
		<NoWin32Manifest>true</NoWin32Manifest>
		<Title>ASP.NET Core Identity Provider for Cosmos DB, MySQL, SQL Server, and SQLite</Title>
	</PropertyGroup>

	<PropertyGroup>
	  <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

	<ItemGroup>
	  <Content Remove="stylecop.json" />
	  <None Remove="stylecop.json" />
	  <AdditionalFiles Include="stylecop.json" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AspNetCore.Identity.CosmosDb" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Cosmos" />
		<PackageReference Include="Microting.EntityFrameworkCore.MySql" />
		<PackageReference Include="Roslynator.Analyzers">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
		<!-- MySQL provider disabled for .NET 10 upgrade - Pomelo incompatible with EF Core 10 -->
		<!-- <PackageReference Include="MySqlConnector" /> -->
		<!-- <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" /> -->
		<PackageReference Include="Duende.IdentityServer.EntityFramework.Storage" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="B2C_BrandIcon_Black.png" />
		<Content Include="_res\icons\B2C_BrandIcon_Black.png" />
	</ItemGroup>

	<ItemGroup>
		<None Include="NUGET.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="_res\icons\nuget-icon.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <None Update="B2C_BrandIcon_Black.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
