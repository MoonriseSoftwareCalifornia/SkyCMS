@page
@model Sky.Editor.Areas.Setup.Pages.IndexModel
@{
    ViewData["Title"] = "Welcome";
}

@section Styles {
    <link rel="stylesheet" href="~/css/setup-sensitive-fields.css" />
}

@section Scripts {
    <script src="~/js/setup-sensitive-fields.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/js/all.min.js" crossorigin="anonymous"></script>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        @await Html.PartialAsync("_SetupStepIndicator", 0) @* Current step number *@


        <div style="display:none">@Model.DbStatus.ToString()</div>
        <div class="text-center mb-5">
            <h2>Welcome to SkyCMS Setup Wizard</h2>
        </div>

        <div class="card mb-4 bg-secondary text-light">
            <div class="card-body">
                @*
                    If any of the services are pre-configured, show what is configured.
                *@
                @if (Model.CdnIsPreconfigured || Model.EmailIsPreConfigured || Model.StorageIsPreConfigured)
                {
                    <p class="card-text">Please have the following ready:</p>
                    <ul>
                        @if (!Model.StorageIsPreConfigured)
                        {
                            <li><strong>Storage Connection String</strong> - For Azure Blob Storage, AWS S3 (or compatible), or Cloudflare R2</li>
                        }
                        <li><strong>Administrator Email & Password</strong> - For the initial admin account</li>
                        @if (!Model.PublisherIsPreConfigured)
                        {
                            <li><strong>Publisher URL</strong> - The public address of the website</li>
                        }
                        @if (!Model.EmailIsPreConfigured)
                        {
                            <li><strong>Email service credentials</strong>  (Optional for dev/test installs) SendGrid, Azure Communication Services, or SMTP</li>
                        }
                        @if (!Model.CdnIsPreconfigured)
                        {
                            <li><strong>CDN service credentials</strong>  (Optional) Azure, CloudFlare or Securi</li>
                        }
                    </ul>
                    <hr />
                    <p class="card-text">The following is preconfigured:</p>
                    <ul>
                        @* Database is already pre-configured *@
                        <li>Database</li>
                        @if (Model.StorageIsPreConfigured)
                        {
                            <li>Storage</li>
                        }
                        @if (Model.PublisherIsPreConfigured)
                        {
                            <li>Website address (URL)</li>
                        }
                        @if (Model.EmailIsPreConfigured)
                        {
                            <li>Email service</li>
                        }
                        @if (Model.CdnIsPreconfigured)
                        {
                            <li>CDN provider</li>
                        }
                    </ul>
                }
                else
                {
                    <h5 class="card-title"><i class="fas fa-info-circle"></i> Things to setup:</h5>
                    <p class="card-text">Please ensure you have the following information ready before continuing.</p>
                    <ul>
                        <li><strong>Storage Connection String</strong> - For Azure Blob Storage, AWS S3 (or compatible), or Cloudflare R2</li>
                        <li><strong>Administrator Email & Password</strong> - For the initial admin account</li>
                        <li><strong>Publisher URL</strong> - The public URL of your website</li>
                        <li><strong>(Optional)</strong> Email service credentials (SendGrid, Azure Communication Services, or SMTP)</li>
                        <li><strong>(Optional)</strong> CDN service credentials (Azure, CloudFlare or Securi)</li>
                    </ul>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <strong>Error:</strong> @Model.ErrorMessage
            </div>
        }
        else
        {

            <form method="post">
                @* @Html.AntiForgeryToken() *@
                <div class="d-flex justify-content-between mt-4">
                    <a href="/" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Next <i class="fas fa-arrow-right"></i></button>
                </div>
            </form>
        }
    </div>
</div>

