@page
@model Sky.Editor.Areas.Setup.Pages.SummaryModel
@{
    ViewData["Title"] = "Setup Summary";
}

@section Styles {
    <link rel="stylesheet" href="~/css/setup-sensitive-fields.css" />
}

@section Scripts {
    <script src="~/js/setup-sensitive-fields.js"></script>
}

@await Html.PartialAsync("_SetupStepIndicator", 7)

<div class="container mt-5">
    <h2>Setup Summary & Critical Settings</h2>
    <p class="text-muted">Review your configuration before completing setup.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Critical Settings Warning Banner -->
    <div class="setup-confirmation-banner mb-4">
        <h3><i class="fas fa-exclamation-triangle"></i> ?? Critical Configuration</h3>
        <p>
            The settings below are critical to your website's functionality. <strong>Incorrect values will break your website.</strong>
            Please review each setting carefully before completing setup.
        </p>
        <div class="setup-confirmation-critical-list">
            <strong>Settings that require special attention:</strong>
            <ul>
                <li><strong>Database Connection</strong> - Must be a valid, accessible database</li>
                <li><strong>Storage Connection</strong> - Must be a valid cloud storage account</li>
                <li><strong>Blob Public URL</strong> - Must match your storage provider's public URL</li>
                <li><strong>Email Provider</strong> - For system notifications and contact forms</li>
                <li><strong>Publisher URL</strong> - Must be reachable from this application</li>
            </ul>
        </div>
    </div>

    <!-- Critical Settings Table -->
    <div class="card mb-4">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="fas fa-cog"></i> Critical Settings</h5>
        </div>
        <div class="card-body">
            <table class="table table-sm table-bordered change-summary-table">
                <thead>
                    <tr>
                        <th>Setting</th>
                        <th>Value</th>
                        <th>Status</th>
                        <th>Impact</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Database Connection -->
                    <tr class="@(Model.CriticalSettings.DatabaseConnection.IsConfigured ? "table-success" : "table-danger")">
                        <td>
                            <strong class="critical-setting-highlight">@Model.CriticalSettings.DatabaseConnection.Name</strong>
                        </td>
                        <td>
                            <span class="change-value-masked">@Model.CriticalSettings.DatabaseConnection.Value</span>
                        </td>
                        <td>
                            @if (Model.CriticalSettings.DatabaseConnection.IsConfigured)
                            {
                                <span class="badge bg-success"><i class="fas fa-check-circle"></i> Configured</span>
                            }
                            else
                            {
                                <span class="badge bg-danger"><i class="fas fa-times-circle"></i> Not Configured</span>
                            }
                        </td>
                        <td>
                            <small>@Model.CriticalSettings.DatabaseConnection.Description</small>
                        </td>
                    </tr>

                    <!-- Storage Connection -->
                    <tr class="@(Model.CriticalSettings.StorageConnection.IsConfigured ? "table-success" : "table-danger")">
                        <td>
                            <strong class="critical-setting-highlight">@Model.CriticalSettings.StorageConnection.Name</strong>
                        </td>
                        <td>
                            <span class="change-value-masked">@Model.CriticalSettings.StorageConnection.Value</span>
                        </td>
                        <td>
                            @if (Model.CriticalSettings.StorageConnection.IsConfigured)
                            {
                                <span class="badge bg-success"><i class="fas fa-check-circle"></i> Configured</span>
                            }
                            else
                            {
                                <span class="badge bg-danger"><i class="fas fa-times-circle"></i> Not Configured</span>
                            }
                        </td>
                        <td>
                            <small>@Model.CriticalSettings.StorageConnection.Description</small>
                        </td>
                    </tr>

                    <!-- Blob Public URL -->
                    <tr class="@(Model.CriticalSettings.BlobPublicUrl.IsConfigured ? "table-success" : "table-warning")">
                        <td>
                            <strong class="critical-setting-highlight">@Model.CriticalSettings.BlobPublicUrl.Name</strong>
                        </td>
                        <td>
                            <code>@Model.CriticalSettings.BlobPublicUrl.Value</code>
                        </td>
                        <td>
                            @if (Model.CriticalSettings.BlobPublicUrl.IsConfigured)
                            {
                                <span class="badge bg-success"><i class="fas fa-check-circle"></i> Configured</span>
                            }
                            else
                            {
                                <span class="badge bg-warning"><i class="fas fa-exclamation-circle"></i> Check</span>
                            }
                        </td>
                        <td>
                            <small>@Model.CriticalSettings.BlobPublicUrl.Description</small>
                        </td>
                    </tr>

                    <!-- Email Provider -->
                    <tr class="@(Model.CriticalSettings.EmailProvider.IsConfigured ? "table-success" : "table-warning")">
                        <td>
                            <strong>@Model.CriticalSettings.EmailProvider.Name</strong>
                        </td>
                        <td>
                            @Model.CriticalSettings.EmailProvider.Value
                        </td>
                        <td>
                            @if (Model.CriticalSettings.EmailProvider.IsConfigured)
                            {
                                <span class="badge bg-success"><i class="fas fa-check-circle"></i> Configured</span>
                            }
                            else
                            {
                                <span class="badge bg-warning"><i class="fas fa-exclamation-circle"></i> Optional</span>
                            }
                        </td>
                        <td>
                            <small>@Model.CriticalSettings.EmailProvider.Description</small>
                        </td>
                    </tr>

                    <!-- Publisher URL -->
                    <tr class="@(Model.CriticalSettings.PublisherUrl.IsConfigured ? "table-success" : "table-danger")">
                        <td>
                            <strong class="critical-setting-highlight">@Model.CriticalSettings.PublisherUrl.Name</strong>
                        </td>
                        <td>
                            <code>@Model.CriticalSettings.PublisherUrl.Value</code>
                        </td>
                        <td>
                            @if (Model.CriticalSettings.PublisherUrl.IsConfigured)
                            {
                                <span class="badge bg-success"><i class="fas fa-check-circle"></i> Configured</span>
                            }
                            else
                            {
                                <span class="badge bg-danger"><i class="fas fa-times-circle"></i> Not Configured</span>
                            }
                        </td>
                        <td>
                            <small>@Model.CriticalSettings.PublisherUrl.Description</small>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex gap-2 justify-content-between mb-4">
        <form method="post" asp-page-handler="Back" class="d-inline">
            <button type="submit" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Go Back & Edit
            </button>
        </form>

        <form method="post" asp-page-handler="Complete" class="d-inline">
            @if (Model.SetupConfiguration?.Id != Guid.Empty)
            {
                <input type="hidden" asp-for="SetupConfiguration.Id" />
            }
            <button type="submit" class="btn btn-success" onclick="return confirm('Are you sure you want to complete the setup? Make sure all critical settings are correct.');">
                <i class="fas fa-check-circle"></i> Complete Setup
            </button>
        </form>
    </div>

    <!-- Additional Info -->
    <div class="alert alert-info">
        <h5><i class="fas fa-info-circle"></i> Post-Setup Changes</h5>
        <p class="mb-0">
            After setup is complete, administrators can return to this wizard to modify these settings at any time.
            All changes will be audited and logged for security purposes.
        </p>
    </div>
</div>

<input type="hidden" asp-for="SetupConfiguration.Id" />
