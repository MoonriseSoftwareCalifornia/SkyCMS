@page
@model Sky.Editor.Areas.Setup.Pages.Step6_Review
@{
    ViewData["Title"] = "Review & Complete";
    Layout = "_LayoutSetup";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        @await Html.PartialAsync("_SetupStepIndicator", 6)

        <h2>Review Configuration</h2>
        <p>Please review your settings before completing the setup</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <strong>Error:</strong> @Model.ErrorMessage
            </div>
        }

        <h5>Administrator Account</h5>
        <ul>
            <li class="list-checked">Admin email: @Model.Config.AdminEmail</li>
            <li class="list-checked">Admin password: ********************</li>
        </ul>
        <h5>Website Setup</h5>
        <ul>
            <li class="list-checked">Website address: @Model.Config.PublisherUrl</li>

            @if (string.IsNullOrWhiteSpace(Model.Config.SiteDesignId))
            {
                <li class="list-unchecked">
                    Site theme: Not setup
                </li>
            }
            else
            {
                <li class="list-checked">
                    Site theme: @Model.SiteDesignName
                </li>
            }

            <li class="list-checked">
                Publishing mode: @(Model.Config.StaticWebPages ? "Static Pages" : "Dynamic rendering")
            </li>
        </ul>
        <h5>Service Connections</h5>
        <ul>
            <li class="list-checked">
                Database: @Model.DatabaseType
            </li>
            <li class="list-checked">
                Storage: @Model.StorageType
            </li>
            @if (Model.EmailProvider == "None")
            {
                <li class="list-unchecked">
                    Email provider: Not configured
                </li>
            }
            else
            {
                <li class="list-checked">
                    Email provider: @Model.EmailProvider
                </li>
            }
            @if (Model.CdnProvider == "None")
            {
                <li class="list-unchecked">
                    CDN Provider: Not configured
                </li>
            }
            else
            {
                <li class="list-checked">
                    CDN Provider: @Model.CdnProvider
                </li>
            }
        </ul>

        <!-- Action Buttons -->
        <form method="post" id="reviewForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            @Html.AntiForgeryToken()

            <div class="d-flex justify-content-between mt-4">
                <a href="@Url.Page("./Step5_Cdn")" class="btn btn-primary"><i class="fas fa-arrow-left"></i> Back</a>
                <button type="submit" class="btn btn-primary" id="completeButton">
                    Finish <i class="fas fa-arrow-right"></i>
                </button>
            </div>

            <input type="hidden" asp-for="SetupId" />
        </form>


    </div>
</div>

@section Scripts {
}
