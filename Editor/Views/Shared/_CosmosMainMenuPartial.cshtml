@inject IEditorSettings options
@using System.Reflection
@using Cosmos.Cms.Common.Services.Configurations;
@using Microsoft.Extensions.Options;
@using Sky.Editor.Data.Logic
@using Sky.Editor.Services.EditorSettings
@{
    var assemblyName = Assembly.GetExecutingAssembly().GetName();
    var isEditor = false;
    var isAdministrator = false;
    var isAuthor = false;
    var isReviewer = false;
    var loadList = ViewData["LoadEditList"] as bool? ?? false;

    if (User != null && User.IsInRole("Editors"))
    {
        isEditor = true;
    }

    if (User != null && User.IsInRole("Administrators"))
    {
        isAdministrator = true;
    }

    if (User != null && User.IsInRole("Authors"))
    {
        isAuthor = true;
    }

    if (User != null && User.IsInRole("Reviewers"))
    {
        isReviewer = true;
    }
}
<nav id="ccmsNavMenu" class="navbar navbar-expand-sm navbar-dark bg-dark" style="z-index: 20000000;">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            <img src="~/images/skycms/SkyCMSLogoNoWiTextDarkTransparent30h.png" height="30" />
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                @if (User != null && User.Identity != null && (isAdministrator || isEditor || isAuthor || isReviewer))
                {
                    <li class="nav-item dropdown">
                        <a id="btnManage" href="#" role="button" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            Menu
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" id="ddManageMenu">
                            <li>
                                <a class="dropdown-item" title="Website page list." asp-action="Index" asp-controller="Editor">Pages</a>
                            </li>
                            <li>
                                <a id="btnNewPage" class="ms-2 fw-lighter dropdown-item" title="Creates new page using this one as it's parent." style="font-size:inherit.8rem">New page <i class="fa-solid fa-circle-arrow-right"></i></a>
                            </li>
                            <li>
                                <a class="dropdown-item" title="Website blog list." href="/Editor/Blogs">Blogs</a>
                            </li>
                            <li>
                                <a class="dropdown-item" title="Open files stored on this website." href="/FileManager/Index">File Manager</a>
                            </li>
                            @if (isAdministrator || isEditor)
                            {
                                <li>
                                    <a class="dropdown-item" title="Manage page templates" href="/Templates/Index">Templates</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" title="Manage layouts" href="/Layouts/Index">Site Design</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" title="Manage customer contacts." asp-action="Index" asp-controller="Cosmos___Contacts">Contacts</a>
                                </li>
                                <li>
                                    <a id="btnPublicWebsite" class="dropdown-item" title="Open public (publisher) website" href="" target="_blank">Public Website</a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" title="Manage user accounts." asp-action="Index" asp-controller="Users">Users</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" title="Publish entire website and refresh CDN." href="/Editor/Publish">Publish Website</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" title="Open page scheduling service." href="/Editor/Scheduler">Page Scheduler</a>
                                </li>
                            }
                            @if (isAdministrator)
                            {
                                <li>
                                    <a class="dropdown-item" title="Website settings." asp-action="Index" asp-controller="Cosmos___Settings">Settings</a>
                                </li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item fw-lighter" title="Sky CMS is licensed to users under GNU General Public License Version 3." href="https://github.com/CWALabs/SkyCMS?tab=GPL-3.0-1-ov-file#readme" target="_blank">User License</a>
                            </li>
                        </ul>
                    </li>
                }
                <li id="editorDropDown" class="nav-item dropdown">
                    <a id="navbarEditDropdown" onclick="loadDdEditMenu()" class="nav-link dropdown-toggle" href="#"
                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Edit
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark" id="ddEditMenu">
                    </ul>
                </li>
                <li class="nav-item"><span title="Cosmos Version" class="nav-link text-mute">@assemblyName.Version.ToString()</span></li>
                @if (Context.Request.Path == "/home/preview")
                {
                    <li class="nav-item"><a class="btn btn-sm btn-primary mt-2" title="Close preview" href="javascript:closePreview()">Close Preview</a></li>
                }
            </ul>

            <div class="d-flex">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </div>
</nav>
<script src="~/lib/cosmos/editDropDownBuilder.js"></script>
<script>
    const isAuthor = @(isAuthor.ToString().ToLower());
    const isReviewer = @(isReviewer.ToString().ToLower());
    const loadList = @loadList.ToString().ToLower();

    const getEl = (id) => document.getElementById(id);
    const setVisible = (el, visible) => {
        if (!el) {
            return;
        }

        el.style.display = visible ? "" : "none";
    };

    function closePreview() {
        if (window.opener) {
            window.close();
        } else {
            location.href = "/Editor/Versions/@Context.Request.Query["ArticleNumber"]";
        }
    }

    function loadDdEditMenu() {
        const editorDropDown = getEl("editorDropDown");
        const ddMenu = getEl("ddEditMenu");
        if (!ddMenu) {
            return;
        }

        if (isReviewer) {
            setVisible(editorDropDown, false);
            return;
        }

        ddMenu.innerHTML = "Loading...";

        const iframe = getEl("iFrameWebPage");
        const iframeWin = iframe?.contentWindow || iframe?.contentDocument?.parentWindow;
        const targetPath = iframeWin?.parent?.location?.pathname || window.location.pathname;
        const apiUrl = `${window.location.origin}/Home/EditList?target=${encodeURIComponent(targetPath)}`;

        fetch(apiUrl, {
            method: "GET",
            headers: {
                Accept: "application/json"
            },
            credentials: "same-origin"
        })
            .then((response) => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                return response.json();
            })
            .then((data) => {
                if (!Array.isArray(data) || isAuthor) {
                    ddMenu.innerHTML = "";
                    return;
                }

                if (typeof ccms___buildEditDropDownMenu !== "function") {
                    throw new Error("Edit dropdown builder library is not loaded.");
                }

                ddMenu.innerHTML = "";

                data.forEach((element, index) => {
                    const builtDropDown = ccms___buildEditDropDownMenu(
                        element.ArticleNumber,
                        element.UsesHtmlEditor === true,
                        `Edit ${element.ArticleNumber}`);

                    const builtMenu = builtDropDown.querySelector(".dropdown-menu");
                    if (!builtMenu) {
                        return;
                    }

                    // Reuse standardized builder items in this existing menu container.
                    Array.from(builtMenu.children).forEach((item) => {
                        ddMenu.appendChild(item);
                    });

                    if (index < data.length - 1) {
                        const divider = document.createElement("li");
                        divider.innerHTML = "<hr class='dropdown-divider'>";
                        ddMenu.appendChild(divider);
                    }
                });

                ddMenu.dataset.loaded = "true";
            })
            .catch((error) => {
                console.error("Error loading edit menu:", error);
                ddMenu.innerHTML = "<li><a class='dropdown-item text-danger' href='#'>Error loading versions</a></li>";
                setVisible(editorDropDown, false);
            });
    }

    function closeDropDowns() {
        getEl("navbarEditDropdown")?.classList.remove("show");
        getEl("ddEditMenu")?.classList.remove("show");
        getEl("btnManage")?.classList.remove("show");
        getEl("ddManageMenu")?.classList.remove("show");
    }

    function attachIframeCloseListeners() {
        const attachSameOriginListener = (iframe) => {
            const tryAttach = () => {
                try {
                    iframe.contentDocument?.addEventListener("click", closeDropDowns, true);
                } catch {
                    // Cross-origin iframe: not directly accessible.
                }
            };

            iframe.addEventListener("load", tryAttach);
            tryAttach();
        };

        document.querySelectorAll("iframe").forEach(attachSameOriginListener);

        window.addEventListener("blur", () => {
            if (document.activeElement?.tagName === "IFRAME") {
                closeDropDowns();
            }
        });
    }

    document.addEventListener("DOMContentLoaded", () => {
        setPublicSiteUrl();

        const editorDropDown = getEl("editorDropDown");
        const ddEditMenu = getEl("ddEditMenu");
        const navMenu = getEl("ccmsNavMenu");

        document.addEventListener("click", (event) => {
            if (navMenu && event.target instanceof Node && !navMenu.contains(event.target)) {
                closeDropDowns();
            }
        }, true);

        if (loadList) {
            setVisible(editorDropDown, true);
        } else {
            setVisible(ddEditMenu, false);
            setVisible(editorDropDown, false);
        }
    });

    window.addEventListener("load", attachIframeCloseListeners);

    function setPublicSiteUrl() {
        const publicBaseUrl = "@options.PublisherUrl.TrimEnd('/')";
        const el = getEl("btnPublicWebsite");
        if (el) {
            el.setAttribute("href", publicBaseUrl);
        }
    }
</script>

<!-- Modal -->
<div class="mt-5 modal fade" id="modalContactUs" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bg-secondary" style="height:700px;">
            <div class="modal-body">
                <iframe id="iframeContactSupport" style="position: absolute; height: 100%; width:90%; border: none"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        getEl("btnGetHelp")?.addEventListener("click", () => {
            getEl("iframeContactSupport")?.setAttribute("src", "/Ccms__ContactUs/Index");
        });

        getEl("btnNewPage")?.addEventListener("click", () => {
            window.location.href = "@Url.Action("Create", "Editor")";
        });
    });
</script>
