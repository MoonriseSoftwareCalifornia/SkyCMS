@{
    Layout = null;
    this.Context.Response.StatusCode = 404; // Or 500 for general errors
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Not Found</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        body {
            font-family: sans-serif;
            text-align: center;
            margin-top: 10vh;
        }

        h1 {
            font-size: 2.5rem;
            color: #c00;
        }

        p {
            font-size: 1.2rem;
        }
    </style>
</head>
<body>
    <h1>404 Not Found</h1>
    <p>The site you are looking for could not be found.</p>
</body>
</html>