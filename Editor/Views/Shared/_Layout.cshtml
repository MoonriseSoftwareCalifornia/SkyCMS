<!DOCTYPE HTML>
<html lang="en-us">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag?.Title</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
          integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="~/lib/font-awesome/css/all.min.css">

    <link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet" type="text/css" href="~/css/2024-01-20-01-site.css" />
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/2.2.1/css/dataTables.bootstrap5.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
        .ai-help-floating-window {
            position: fixed;
            top: 84px;
            right: 18px;
            width: 430px;
            height: 860px;
            max-width: calc(100vw - 24px);
            max-height: calc(100vh - 96px);
            background: #111315;
            border: 1px solid #3e3e42;
            border-radius: 8px;
            overflow: hidden;
            z-index: 50050;
            box-shadow: 0 14px 40px rgba(0, 0, 0, 0.45);
        }

        .ai-help-floating-window.is-hidden {
            display: none;
        }

        .ai-help-floating-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 8px 10px;
            background: #1d1f24;
            border-bottom: 1px solid #333;
            cursor: move;
        }

        .ai-help-floating-title {
            font-size: 0.85rem;
            color: #cfd6de;
        }

        .ai-help-floating-body {
            width: 100%;
            height: calc(100% - 46px);
        }

        .ai-help-floating-frame {
            width: 100%;
            height: 100%;
            border: 0;
            background: #111315;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js" integrity="sha256-lSjKY0/srUM9BE3dPm+c4fBo1dky2v27Gdjm2uoZaL0=" crossorigin="anonymous"></script>

    <script src="https://cdn.datatables.net/2.2.1/js/dataTables.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.datatables.net/2.2.1/js/dataTables.bootstrap5.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4" crossorigin="anonymous"></script>
    <script src="/ccms/js/TimeUtils.js"></script>
    <script>
        let aiHelpFloatingInitialized = false;

        function cwpsSelectTableRow(element, isSelected) {
            const row = $(element).closest('tr');
            $(row).find('td').each(function (c, td) {
                if (isSelected) {
                    $(td).addClass("cwps-std-tbl-row-selected");
                } else {
                    $(td).removeClass("cwps-std-tbl-row-selected");
                }
            });
        }

        function ccmsInitializeAiHelpFloatingWindow() {
            if (aiHelpFloatingInitialized) {
                return;
            }

            const container = document.getElementById('aiHelpFloatingWindow');
            const closeButton = document.getElementById('btnCloseAiHelpFloatingWindow');
            if (!container) {
                return;
            }

            if (closeButton) {
                closeButton.addEventListener('click', function () {
                    ccmsCloseAiHelpFloatingWindow();
                });
            }

            if (typeof $ === 'function' && typeof $.fn.draggable === 'function') {
                $('#aiHelpFloatingWindow').draggable({
                    handle: '#aiHelpFloatingHeader',
                    containment: 'window'
                });
            }

            aiHelpFloatingInitialized = true;
        }

        function ccmsOpenAiHelpFloatingWindow(url) {
            const container = document.getElementById('aiHelpFloatingWindow');
            const frame = document.getElementById('aiHelpFloatingFrame');
            if (!container || !frame) {
                window.open(url || '/Editor/AiHelp?popup=1', 'SkyCmsAiHelp', 'popup=yes,width=430,height=900,scrollbars=yes,resizable=yes');
                return false;
            }

            ccmsInitializeAiHelpFloatingWindow();

            const targetUrl = url || '/Editor/AiHelp?popup=1';
            if (frame.getAttribute('src') !== targetUrl) {
                frame.setAttribute('src', targetUrl);
            }

            container.classList.remove('is-hidden');
            container.setAttribute('aria-hidden', 'false');
            return false;
        }

        function ccmsCloseAiHelpFloatingWindow() {
            const container = document.getElementById('aiHelpFloatingWindow');
            if (!container) {
                return;
            }

            container.classList.add('is-hidden');
            container.setAttribute('aria-hidden', 'true');
        }
    </script>
</head>
<body class="cwps-body" style="background-color:#323236">
    <partial name="_CosmosMainMenuPartial" model="null" />

    <div id="aiHelpFloatingWindow" class="ai-help-floating-window is-hidden" aria-hidden="true">
        <div id="aiHelpFloatingHeader" class="ai-help-floating-header">
            <span class="ai-help-floating-title">AI Help</span>
            <button id="btnCloseAiHelpFloatingWindow" type="button" class="btn btn-sm btn-outline-light">Close</button>
        </div>
        <div class="ai-help-floating-body">
            <iframe id="aiHelpFloatingFrame" class="ai-help-floating-frame" title="AI Help Chat"></iframe>
        </div>
    </div>

    @RenderBody()
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
