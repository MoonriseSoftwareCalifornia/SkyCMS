    }

    .ccms-elfinder-wrap .elfinder-dialog input:focus,
    .ccms-elfinder-wrap .elfinder-dialog textarea:focus,
    .ccms-elfinder-wrap .elfinder-dialog select:focus,
    .ccms-elfinder-wrap .elfinder-navbar input:focus,
    .ccms-elfinder-wrap .elfinder input.elfinder-cwd-search:focus {
        border-color: var(--ef-accent) !important;
        box-shadow: 0 0 0 2px rgba(61, 160, 255, 0.25) !important;
    }

    .ccms-elfinder-wrap .elfinder-dialog .ui-button,
    .ccms-elfinder-wrap .elfinder .ui-dialog-buttonpane .ui-button {
        background: var(--ef-accent-strong) !important;
        color: #fff !important;
        border: 1px solid #1869bb !important;
    }

    .ccms-elfinder-wrap .elfinder-dialog .ui-button:hover,
    .ccms-elfinder-wrap .elfinder .ui-dialog-buttonpane .ui-button:hover {
        background: var(--ef-accent) !important;
    }

    .ccms-elfinder-wrap .elfinder-button-menu-separator,
    .ccms-elfinder-wrap .elfinder-contextmenu-separator,
    .ccms-elfinder-wrap .elfinder-statusbar,
    .ccms-elfinder-wrap .elfinder-path {
        border-color: var(--ef-border) !important;
    }

    .ccms-elfinder-wrap .elfinder-button-menu-item.elfinder-button-menu-item-del,
    .ccms-elfinder-wrap .elfinder-contextmenu-item.elfinder-contextmenu-item-del {
        color: var(--ef-danger) !important;
    }

    .ccms-elfinder-wrap .elfinder-button-menu-item.elfinder-button-menu-item-del:hover,
    .ccms-elfinder-wrap .elfinder-contextmenu-item.elfinder-contextmenu-item-del:hover {
