@using Sky.Editor.Services.EditorSettings
@inject IEditorSettings options
@{
    var selectOne = ViewData["SelectOne"] is bool s && s;
    var directoryOnly = ViewData["DirectoryOnly"] is bool d && d;
    var imagesOnly = ViewData["ImagesOnly"] is bool i && i;
    var target = Context.Request.Query["target"].ToString();
    if (string.IsNullOrEmpty(target)) { target = "/pub"; }

    var connectorUrl = Url.Action("Connector", "ElFinderConnector") ?? "/FileManager/ElFinderConnector";

    if (directoryOnly)
    {
        ViewData["Title"] = "File Manager – Folder View";
    }
    else if (imagesOnly)
    {
        ViewData["Title"] = "Select an Image";
    }
    else
    {
        ViewData["Title"] = "File Manager";
    }
}

@* elFinder core – BSD-3-Clause license (Studio-42/elFinder) *@
<link rel="stylesheet"
      href="~/lib/elfinder/css/elfinder.min.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/lib/filepond/filepond.min.css"
      asp-append-version="true" />

<style>
    /* ── Layout shell ─────────────────────────────────────────── */
    .ccms-elfinder-wrap {
        --ef-bg: #14171d;
        --ef-panel: #1a1f27;
        --ef-panel-2: #202734;
        --ef-border: #2e3646;
        --ef-text: #dde6f3;
        --ef-muted: #9aa7bc;
        --ef-accent: #3da0ff;
        --ef-accent-strong: #1f84e4;
        --ef-selected: #1f4063;
        --ef-hover: #273245;
        --ef-danger: #e06d76;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 72px);
        padding: 0;
        background: radial-gradient(circle at 20% 10%, #1d2633 0%, var(--ef-bg) 55%);
    }

    /* ── elFinder context menu contrast ───────────────────────── */
    .elfinder .elfinder-contextmenu,
    .elfinder .elfinder-contextmenu-sub {
        background: #6b7280 !important;
        color: #ffffff !important;
        border-color: #7a7a7a !important;
    }

    .elfinder .elfinder-contextmenu-item,
    .elfinder .elfinder-contextmenu-item span,
    .elfinder .elfinder-contextmenu-item .elfinder-contextmenu-arrow {
        color: #ffffff !important;
    }

    .elfinder .elfinder-contextmenu-item.ui-state-active,
    .elfinder .elfinder-contextmenu-item.ui-state-hover,
    .elfinder .elfinder-contextmenu-item:hover {
        background: #116ab7 !important;
        color: #ffffff !important;
        border-color: #116ab7 !important;
    }

    .ccms-upload-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        background: linear-gradient(180deg, #1a2230 0%, #161d29 100%);
        border: 1px solid var(--ef-border);
        border-bottom: 0;
    }

    .ccms-upload-status {
        margin: 0;
        color: var(--ef-muted);
        font-size: 0.875rem;
        min-width: 180px;
    }

    .ccms-upload-btn {
        border: 1px solid var(--ef-border);
        background: #1b2737;
        color: var(--ef-text);
        border-radius: 6px;
        padding: 6px 10px;
        line-height: 1.2;
        white-space: nowrap;
    }

        .ccms-upload-btn:hover {
            background: #223148;
        }

    .ccms-elfinder-wrap.ccms-drop-active #ccmsElFinder {
        box-shadow: inset 0 0 0 2px rgba(122, 162, 247, 0.45);
    }

    .ccms-upload-bar .filepond--root {
        margin: 0;
        flex: 1;
    }

    .ccms-upload-bar .filepond--panel-root {
        background: #10151d;
        border: 1px solid var(--ef-border);
    }

    .ccms-upload-bar .filepond--drop-label {
        color: var(--ef-text);
    }

    .ccms-upload-bar .filepond--credits {
        display: none;
    }

    /* Ensure elFinder operation progress remains visible with custom theming. */
    .ccms-elfinder-wrap .elfinder-ui-progressbar {
        background-color: var(--ef-accent) !important;
        filter: none;
        height: 3px;
        z-index: 4;
    }

    .ccms-elfinder-wrap .elfinder-notify-progressbar {
        border-color: #4e5b70;
        background: #0f1520;
    }

    .ccms-elfinder-wrap .elfinder-notify-progress {
        background-color: var(--ef-accent) !important;
    }

    .ccms-upload-modal {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(6, 10, 16, 0.72);
        z-index: 1050;
    }

    .ccms-upload-modal.ccms-open {
        display: flex;
    }

    .ccms-upload-modal-panel {
        width: min(560px, calc(100vw - 32px));
        max-height: 72vh;
        overflow: auto;
        border: 1px solid var(--ef-border);
        border-radius: 10px;
        background: linear-gradient(180deg, #121824 0%, #0d131d 100%);
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.45);
        padding: 14px;
        color: var(--ef-text);
    }

    .ccms-upload-modal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
    }

    .ccms-upload-modal-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
    }

    .ccms-upload-modal-close {
        border: 1px solid var(--ef-border);
        background: #1b2737;
        color: var(--ef-text);
        border-radius: 6px;
        padding: 4px 8px;
        line-height: 1.2;
    }

    .ccms-upload-progress-list {
        display: grid;
        gap: 8px;
    }

    .ccms-upload-progress-item {
        border: 1px solid #2a3342;
        border-radius: 8px;
        background: #111826;
        padding: 8px 10px;
    }

    .ccms-upload-progress-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 6px;
        font-size: 0.88rem;
    }

    .ccms-upload-progress-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ccms-upload-progress-state {
        color: var(--ef-muted);
        white-space: nowrap;
    }

    .ccms-upload-progress-track {
        height: 6px;
        border-radius: 999px;
        background: #1f2a3b;
        overflow: hidden;
    }

    .ccms-upload-progress-fill {
        height: 100%;
        width: 0;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--ef-accent-strong), var(--ef-accent));
        transition: width 120ms linear;
    }
</style>

<div class="ccms-elfinder-wrap" id="ccmsElFinderWrap">
    @if (!directoryOnly)
    {
        <div class="ccms-upload-bar">
            <p class="ccms-upload-status" id="ccmsUploadStatus">Ready to upload</p>
            <button type="button" id="ccmsUploadBrowseBtn" class="ccms-upload-btn">Upload Files</button>
            <input type="file"
                   id="ccmsFilepond"
                   name="files"
                   class="filepond"
                   data-file-metadata-path="@target"
                   multiple>
        </div>
    }
    <div id="ccmsElFinder"></div>
</div>

<div class="ccms-upload-modal" id="ccmsUploadModal" aria-hidden="true">
    <div class="ccms-upload-modal-panel" role="dialog" aria-modal="true" aria-labelledby="ccmsUploadModalTitle">
        <div class="ccms-upload-modal-head">
            <h2 class="ccms-upload-modal-title" id="ccmsUploadModalTitle">Upload Progress</h2>
            <button type="button" id="ccmsUploadModalClose" class="ccms-upload-modal-close">Close</button>
        </div>
        <div class="ccms-upload-progress-list" id="ccmsUploadProgressList"></div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/elfinder/js/elfinder.min.js"
            asp-append-version="true"></script>
    <script src="~/lib/filepond-plugin-file-metadata/dist/filepond-plugin-file-metadata.min.js"
            asp-append-version="true"></script>
    <script src="~/lib/filepond/filepond.min.js"
            asp-append-version="true"></script>
    <script>
            (function () {
                // ── Encode path to elFinder hash ──────────────────────────
                function encodePath(path) {
                    var trimmed = path.replace(/^\//, '');
                    var encoded = btoa(unescape(encodeURIComponent(trimmed)))
                        .replace(/\+/g, '-')
                        .replace(/\//g, '_')
                        .replace(/=+$/, '');
                    return 'l1_' + encoded;
                }

                function decodePath(hash) {
                    if (!hash || hash.indexOf('l1_') !== 0) {
                        return null;
                    }

                    var encoded = hash.substring(3)
                        .replace(/-/g, '+')
                        .replace(/_/g, '/');

                    while (encoded.length % 4 !== 0) {
                        encoded += '=';
                    }

                    try {
                        var decoded = decodeURIComponent(escape(atob(encoded)));
                        return normalizePath('/' + decoded);
                    } catch {
                        return null;
                    }
                }

                function normalizePath(path) {
                    if (!path) {
                        return '/pub';
                    }

                    var clean = path.replace(/\\/g, '/').replace(/\/+/g, '/');
                    if (clean.charAt(0) !== '/') {
                        clean = '/' + clean;
                    }

                    if (clean.length > 1 && clean.endsWith('/')) {
                        clean = clean.substring(0, clean.length - 1);
                    }

                    return clean;
                }

                function updateUploadStatus(message) {
                    var status = document.getElementById('ccmsUploadStatus');
                    if (!status) {
                        return;
                    }

                    status.textContent = message;
                }

                function updateReadyUploadStatus() {
                    updateUploadStatus('Ready to upload to ' + currentUploadPathDisplay);
                }

                function getFileDedupKey(file) {
                    if (!file) {
                        return null;
                    }

                    var modified = typeof file.lastModified === 'number' ? file.lastModified : 0;
                    return [file.name || '', file.size || 0, modified].join('::');
                }

                function openUploadModal() {
                    if (!uploadModal) {
                        return;
                    }

                    uploadModal.classList.add('ccms-open');
                    uploadModal.setAttribute('aria-hidden', 'false');
                }

                function closeUploadModal() {
                    if (!uploadModal) {
                        return;
                    }

                    uploadModal.classList.remove('ccms-open');
                    uploadModal.setAttribute('aria-hidden', 'true');
                }

                function ensureProgressItem(fileItem) {
                    if (!uploadProgressList) {
                        return null;
                    }

                    var originalFile = fileItem && fileItem.file ? fileItem.file : fileItem;
                    var key = getFileDedupKey(originalFile);
                    if (!key) {
                        return null;
                    }

                    if (uploadProgressMap[key]) {
                        return uploadProgressMap[key];
                    }

                    var root = document.createElement('div');
                    root.className = 'ccms-upload-progress-item';

                    var row = document.createElement('div');
                    row.className = 'ccms-upload-progress-row';

                    var nameNode = document.createElement('span');
                    nameNode.className = 'ccms-upload-progress-name';
                    nameNode.textContent = (fileItem && fileItem.filename) || (originalFile && originalFile.name) || 'File';

                    var stateNode = document.createElement('span');
                    stateNode.className = 'ccms-upload-progress-state';
                    stateNode.textContent = 'Queued';

                    row.appendChild(nameNode);
                    row.appendChild(stateNode);

                    var track = document.createElement('div');
                    track.className = 'ccms-upload-progress-track';

                    var fill = document.createElement('div');
                    fill.className = 'ccms-upload-progress-fill';

                    track.appendChild(fill);
                    root.appendChild(row);
                    root.appendChild(track);
                    uploadProgressList.appendChild(root);

                    uploadProgressMap[key] = {
                        root: root,
                        state: stateNode,
                        fill: fill
                    };

                    return uploadProgressMap[key];
                }

                function setProgressState(fileItem, label, widthPercent) {
                    var item = ensureProgressItem(fileItem);
                    if (!item) {
                        return;
                    }

                    item.state.textContent = label;
                    if (typeof widthPercent === 'number') {
                        var safe = Math.max(0, Math.min(100, widthPercent));
                        item.fill.style.width = safe + '%';
                    }
                }

                function hasPendingUploads() {
                    if (!pond || typeof pond.getFiles !== 'function') {
                        return false;
                    }

                    var files = pond.getFiles();
                    for (var i = 0; i < files.length; i++) {
                        if (files[i] && files[i].status !== 5 && files[i].status !== 8) {
                            return true;
                        }
                    }

                    return false;
                }

                function refreshElFinderFolder() {
                    if (elFinderInstance && typeof elFinderInstance.reload === 'function') {
                        elFinderInstance.reload();
                    }
                }

                // ── Starting target hash ──────────────────────────────────
                var startTarget = encodePath('@Html.Raw(target)');
                var currentUploadPath = normalizePath('@Html.Raw(target)');
                var currentUploadPathDisplay = currentUploadPath;
                var elFinderInstance = null;
                var pond = null;
                var uploadModal = document.getElementById('ccmsUploadModal');
                var uploadModalClose = document.getElementById('ccmsUploadModalClose');
                var uploadProgressList = document.getElementById('ccmsUploadProgressList');
                var uploadProgressMap = Object.create(null);

                // ── File-selection callback (selectOne / imagesOnly) ──────
                var pickCallback = null;

        @if (selectOne || imagesOnly)
        {
                    <text>
                        pickCallback = function (file) {
                            var url = file.url || '';
                            if (typeof window.parent !== 'undefined') {
                                if (typeof window.parent.CCMS___FileManagerPick === 'function') {
                                    window.parent.CCMS___FileManagerPick(url);
                                } else if (typeof window.parent.selectImage === 'function') {
                                    window.parent.selectImage(url);
                                }
                            }
                        };
                    </text>
        }

                // ── elFinder initialisation ───────────────────────────────
                var efOptions = {
                    url: '@connectorUrl',
                    lang: 'en',
                    themes : {
                        'mt-darkblue' : '../elfinder-material-theme/manifests/darkblue.json?v=2',
                        'mt-gray'     : '../elfinder-material-theme/manifests/gray.json?v=2',
                        'mt-light'    : '../elfinder-material-theme/manifests/light.json?v=2',
                    },
                    theme: 'mt-gray',
                    resizable: false,
                    baseUrl: '/lib/elfinder/',
                    uiOptions: {
                        toolbar: [
                            ['back', 'forward'],
                            ['reload'],
                            ['home', 'up'],
                            ['mkdir', 'mkfile'],
                            ['open', 'download'],
                            ['info'],
                            ['quicklook'],
                            ['copy', 'cut', 'paste'],
                            ['rm'],
                            ['rename'],
                            ['search'],
                            ['view', 'sort']
                        ],
                    },
                    startPathHash: startTarget,
                    handlers: {
                        open: function (event) {
                            var cwd = null;

                            if (event && event.data && event.data.cwd && event.data.cwd.hash) {
                                cwd = decodePath(event.data.cwd.hash);
                            }

                            if (!cwd && elFinderInstance && typeof elFinderInstance.cwd === 'function') {
                                var active = elFinderInstance.cwd();
                                if (active && active.hash) {
                                    cwd = decodePath(active.hash);
                                }
                            }

                            if (cwd) {
                                currentUploadPath = cwd;

                                if (event && event.data && event.data.cwd && event.data.cwd.options && event.data.cwd.options.path) {
                                    currentUploadPathDisplay = normalizePath('/' + event.data.cwd.options.path);
                                } else {
                                    currentUploadPathDisplay = cwd;
                                }

                                updateReadyUploadStatus();
                            }
                        },
                        error: function (event) {
                            var err = event.data && event.data.error;
                            if (window.console && err) { console.warn('[elFinder]', err); }
                        }
                    }
                };

        @if (directoryOnly)
        {
                    <text>
                        efOptions.commandsOptions = { open: { dirs: true } };
                        efOptions.onlyMimes = ['directory'];
                    </text>
        }
        @if (imagesOnly)
        {
                    <text>
                        efOptions.onlyMimes = ['image'];
                    </text>
        }
                if (pickCallback !== null) {
                    efOptions.getFileCallback = pickCallback;
                }

                if (typeof $.fn.elfinder !== 'function') {
                    $('#ccmsElFinder').html('<div class="alert alert-danger" role="alert">File manager failed to load. Please refresh or contact support.</div>');
                    if (window.console) {
                        console.error('[elFinder] Plugin did not load. Check CDN/network access.');
                    }

                    return;
                }

                elFinderInstance = $('#ccmsElFinder').elfinder(efOptions).elfinder('instance');

                if (elFinderInstance && typeof elFinderInstance.cwd === 'function') {
                    var initialCwd = elFinderInstance.cwd();
                    if (initialCwd && initialCwd.hash) {
                        var decodedStart = decodePath(initialCwd.hash);
                        if (decodedStart) {
                            currentUploadPath = decodedStart;
                        }

                        if (initialCwd.options && initialCwd.options.path) {
                            currentUploadPathDisplay = normalizePath('/' + initialCwd.options.path);
                        }
                    }
                }

                updateReadyUploadStatus();

                var inputElement = document.getElementById('ccmsFilepond');
                if (!inputElement || typeof FilePond === 'undefined') {
                    return;
                }

                if (typeof FilePondPluginFileMetadata !== 'undefined') {
                    FilePond.registerPlugin(FilePondPluginFileMetadata);
                }

                pond = FilePond.create(inputElement, {
                    chunkUploads: true,
                    chunkSize: 5242880,
                    chunkForce: true,
                    credits: false,
                    instantUpload: true,
                    beforeAddFile: function (item) {
                        if (!pond || typeof pond.getFiles !== 'function') {
                            return true;
                        }

                        var candidate = item && item.file ? item.file : item;
                        var candidateKey = getFileDedupKey(candidate);
                        if (!candidateKey) {
                            return true;
                        }

                        var existing = pond.getFiles();
                        for (var i = 0; i < existing.length; i++) {
                            var existingFile = existing[i] && existing[i].file ? existing[i].file : null;
                            if (getFileDedupKey(existingFile) === candidateKey) {
                                return false;
                            }
                        }

                        return true;
                    },
                    labelIdle: 'Drop files here or <span class="filepond--label-action">Browse</span>'
                });

                FilePond.setOptions({
                    server: '@Url.Action("Process", "FileManager")'
                });

                pond.on('addfile', function (error, file) {
                    if (error) {
                        updateUploadStatus('Upload preparation failed');
                        return;
                    }

                    file.setMetadata('path', currentUploadPath);
                    file.setMetadata('relativePath', file.relativePath || file.filename);
                    file.setMetadata('fileName', file.filename);

                    openUploadModal();
                    setProgressState(file, 'Queued', 0);
                    updateUploadStatus('Uploading ' + file.filename + '...');
                });

                pond.on('processfilestart', function (file) {
                    openUploadModal();
                    setProgressState(file, 'Uploading', 0);
                    updateUploadStatus('Uploading ' + file.filename + '...');
                });

                pond.on('processfileprogress', function (file, progress) {
                    var percent = Math.round((progress || 0) * 100);
                    setProgressState(file, 'Uploading ' + percent + '%', percent);
                });

                pond.on('processfile', function (error, file) {
                    if (error) {
                        setProgressState(file, 'Failed', 100);
                        updateUploadStatus('Upload failed for ' + file.filename);
                        return;
                    }

                    setProgressState(file, 'Completed', 100);
                    updateUploadStatus('Uploaded ' + file.filename + ' to ' + currentUploadPathDisplay);
                });

                pond.on('processfiles', function () {
                    refreshElFinderFolder();

                    if (!hasPendingUploads()) {
                        setTimeout(function () {
                            if (!hasPendingUploads()) {
                                closeUploadModal();
                            }
                        }, 900);
                    }

                    updateReadyUploadStatus();
                });

                var browseButton = document.getElementById('ccmsUploadBrowseBtn');
                if (browseButton) {
                    browseButton.addEventListener('click', function () {
                        if (pond && typeof pond.browse === 'function') {
                            pond.browse();
                            return;
                        }

                        inputElement.click();
                    });
                }

                if (uploadModalClose) {
                    uploadModalClose.addEventListener('click', function () {
                        closeUploadModal();
                    });
                }

                var wrap = document.getElementById('ccmsElFinderWrap');
                var dropTargets = [wrap, document.getElementById('ccmsElFinder')].filter(Boolean);

                function hasExternalFiles(event) {
                    if (!event || !event.dataTransfer) {
                        return false;
                    }

                    var types = event.dataTransfer.types;
                    if (!types) {
                        return false;
                    }

                    for (var i = 0; i < types.length; i++) {
                        if (types[i] === 'Files') {
                            return true;
                        }
                    }

                    return false;
                }

                function setDropHighlight(active) {
                    if (!wrap) {
                        return;
                    }

                    wrap.classList.toggle('ccms-drop-active', !!active);
                }

                function isEventInsideFilePond(event) {
                    return !!(event && event.target && event.target.closest && event.target.closest('.filepond--root'));
                }

                dropTargets.forEach(function (target) {
                    target.addEventListener('dragenter', function (event) {
                        if (!hasExternalFiles(event)) {
                            return;
                        }

                        if (isEventInsideFilePond(event)) {
                            return;
                        }

                        event.preventDefault();
                        setDropHighlight(true);
                    });

                    target.addEventListener('dragover', function (event) {
                        if (!hasExternalFiles(event)) {
                            return;
                        }

                        if (isEventInsideFilePond(event)) {
                            return;
                        }

                        event.preventDefault();
                        if (event.dataTransfer) {
                            event.dataTransfer.dropEffect = 'copy';
                        }

                        setDropHighlight(true);
                        updateUploadStatus('Drop files to upload into ' + currentUploadPathDisplay);
                    });

                    target.addEventListener('dragleave', function (event) {
                        if (isEventInsideFilePond(event)) {
                            return;
                        }

                        setDropHighlight(false);
                    });

                    target.addEventListener('drop', function (event) {
                        if (!hasExternalFiles(event)) {
                            return;
                        }

                        if (isEventInsideFilePond(event)) {
                            setDropHighlight(false);
                            return;
                        }

                        event.preventDefault();
                        setDropHighlight(false);

                        if (!pond) {
                            updateUploadStatus('Upload is unavailable');
                            return;
                        }

                        var files = event.dataTransfer && event.dataTransfer.files
                            ? Array.prototype.slice.call(event.dataTransfer.files)
                            : [];

                        if (!files.length) {
                            return;
                        }

                        updateUploadStatus('Preparing ' + files.length + ' file(s) for upload to ' + currentUploadPathDisplay + '...');
                        pond.addFiles(files);
                    });
                });
            })();
    </script>
}
