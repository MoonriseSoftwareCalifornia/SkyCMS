@using Sky.Editor.Services.EditorSettings
@inject IEditorSettings options
@{
    var selectOne = ViewData["SelectOne"] is bool s && s;
    var directoryOnly = ViewData["DirectoryOnly"] is bool d && d;
    var imagesOnly = ViewData["ImagesOnly"] is bool i && i;
    var target = Context.Request.Query["target"].ToString();
    if (string.IsNullOrEmpty(target)) { target = "/pub"; }

    var connectorUrl = Url.Action("Connector", "ElFinderConnector") ?? "/FileManager/ElFinderConnector";

    if (directoryOnly)
    {
        ViewData["Title"] = "File Manager – Folder View";
    }
    else if (imagesOnly)
    {
        ViewData["Title"] = "Select an Image";
    }
    else
    {
        ViewData["Title"] = "File Manager";
    }
}

@* elFinder core – BSD-3-Clause license (Studio-42/elFinder) *@
<link rel="stylesheet"
      href="~/lib/elfinder/css/elfinder.min.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/lib/filepond/filepond.min.css"
      asp-append-version="true" />

<style>
    /* ── Layout shell ─────────────────────────────────────────── */
    .ccms-elfinder-wrap {
        --ef-bg: #14171d;
        --ef-panel: #1a1f27;
        --ef-panel-2: #202734;
        --ef-border: #2e3646;
        --ef-text: #dde6f3;
        --ef-muted: #9aa7bc;
        --ef-accent: #3da0ff;
        --ef-accent-strong: #1f84e4;
        --ef-selected: #1f4063;
        --ef-hover: #273245;
        --ef-danger: #e06d76;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 72px);
        padding: 0;
        background: radial-gradient(circle at 20% 10%, #1d2633 0%, var(--ef-bg) 55%);
    }

    /* ── elFinder context menu contrast ───────────────────────── */
    .elfinder .elfinder-contextmenu,
    .elfinder .elfinder-contextmenu-sub {
        background: #6b7280 !important;
        color: #ffffff !important;
        border-color: #7a7a7a !important;
    }

    .elfinder .elfinder-contextmenu-item,
    .elfinder .elfinder-contextmenu-item span,
    .elfinder .elfinder-contextmenu-item .elfinder-contextmenu-arrow {
        color: #ffffff !important;
    }

    .elfinder .elfinder-contextmenu-item.ui-state-active,
    .elfinder .elfinder-contextmenu-item.ui-state-hover,
    .elfinder .elfinder-contextmenu-item:hover {
        background: #116ab7 !important;
        color: #ffffff !important;
        border-color: #116ab7 !important;
    }

    .ccms-upload-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        background: linear-gradient(180deg, #1a2230 0%, #161d29 100%);
        border: 1px solid var(--ef-border);
        border-bottom: 0;
    }

    .ccms-upload-status {
        margin: 0;
        color: var(--ef-muted);
        font-size: 0.875rem;
        min-width: 180px;
    }

    .ccms-upload-btn {
        border: 1px solid var(--ef-border);
        background: #1b2737;
        color: var(--ef-text);
        border-radius: 6px;
        padding: 6px 10px;
        line-height: 1.2;
        white-space: nowrap;
    }

        .ccms-upload-btn:hover {
            background: #223148;
        }

        #ccmsPondDismissBtn {
            display: none;
        }

    /* ── FilePond expanding panel ─────────────────────────────── */

    /* Wrapper that sits in normal flow inside .ccms-upload-bar   */
    #ccmsPondWrap {
        position: relative;
        flex: 1;
        min-width: 0;
    }

    /* When active, the FilePond root lifts out of flow and       */
    /* expands downward over the elFinder panel.                  */
    .ccms-upload-bar.ccms-pond-active {
        position: relative; /* anchor for absolute child */
    }

    .ccms-upload-bar.ccms-pond-active #ccmsPondWrap {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 200;
        background: linear-gradient(180deg, #111825 0%, #0d1219 100%);
        border: 1px solid var(--ef-border);
        border-top: 0;
        border-radius: 0 0 10px 10px;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
        max-height: 72vh;
        overflow-y: auto;
        padding: 8px 0;
        animation: ccmsPondSlideIn 200ms ease forwards;
    }

    .ccms-upload-bar.ccms-pond-active #ccmsPondDismissBtn {
        display: inline-block;
        position: absolute;
        top: 8px;
        right: 10px;
        z-index: 230;
    }

    .ccms-upload-bar.ccms-pond-closing #ccmsPondWrap {
        animation: ccmsPondSlideOut 180ms ease forwards;
    }

    @@keyframes ccmsPondSlideIn {
        from { opacity: 0; transform: translateY(-6px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@keyframes ccmsPondSlideOut {
        from { opacity: 1; transform: translateY(0); }
        to   { opacity: 0; transform: translateY(-6px); }
    }

    /* ── FilePond theme scoped to the panel ──────────────────── */
    #ccmsPondWrap .filepond--root {
        margin: 0;
        font-family: inherit;
    }

    #ccmsPondWrap .filepond--panel-root {
        background: transparent;
        border: none;
    }

    #ccmsPondWrap .filepond--drop-label {
        color: var(--ef-muted);
        font-size: 0.875rem;
    }

    #ccmsPondWrap .filepond--credits {
        display: none;
    }

    #ccmsPondWrap .filepond--item-panel {
        background: #1a2231;
        border-radius: 6px;
    }

    #ccmsPondWrap .filepond--item[data-filepond-item-state='processing-complete'] .filepond--item-panel {
        background: #1f4b34;
    }

    #ccmsPondWrap .filepond--item[data-filepond-item-state='processing-error'] .filepond--item-panel,
    #ccmsPondWrap .filepond--item[data-filepond-item-state='load-error'] .filepond--item-panel,
    #ccmsPondWrap .filepond--item[data-filepond-item-state='processing-revert-error'] .filepond--item-panel {
        background: #5c2830;
    }

    #ccmsPondWrap .filepond--item[data-filepond-item-state='processing-complete'] .filepond--file-status-main {
        color: #a9f5bd;
    }

    #ccmsPondWrap .filepond--item[data-filepond-item-state='processing-error'] .filepond--file-status-main,
    #ccmsPondWrap .filepond--item[data-filepond-item-state='load-error'] .filepond--file-status-main,
    #ccmsPondWrap .filepond--item[data-filepond-item-state='processing-revert-error'] .filepond--file-status-main {
        color: #ffd4d9;
    }

    #ccmsPondWrap .filepond--file {
        color: var(--ef-text);
    }

    #ccmsPondWrap .filepond--file-action-button {
        background: rgba(255, 255, 255, 0.08);
    }

    #ccmsPondWrap .filepond--progress-indicator {
        color: var(--ef-accent);
    }

    /* Ensure elFinder operation progress remains visible with custom theming. */
    .ccms-elfinder-wrap .elfinder-ui-progressbar {
        background-color: var(--ef-accent) !important;
        filter: none;
        height: 3px;
        z-index: 4;
    }

    .ccms-elfinder-wrap .elfinder-notify-progressbar {
        border-color: #4e5b70;
        background: #0f1520;
    }

    .ccms-elfinder-wrap .elfinder-notify-progress {
        background-color: var(--ef-accent) !important;
    }
</style>

<div class="ccms-elfinder-wrap" id="ccmsElFinderWrap">
    @if (!directoryOnly)
    {
        <div class="ccms-upload-bar">
            <p class="ccms-upload-status" id="ccmsUploadStatus">Ready to upload</p>
            <button type="button" id="ccmsUploadBrowseBtn" class="ccms-upload-btn">Upload Files</button>
            <button type="button" id="ccmsPondDismissBtn" class="ccms-upload-btn" aria-label="Close upload panel">Close</button>
            <div id="ccmsPondWrap">
                <input type="file"
                       id="ccmsFilepond"
                       name="files"
                       class="filepond"
                       data-file-metadata-path="@target"
                       multiple>
            </div>
        </div>
    }
    <div id="ccmsElFinder"></div>
</div>



@section Scripts {
    <script src="~/lib/elfinder/js/elfinder.min.js"
            asp-append-version="true"></script>
    <script src="~/lib/filepond-plugin-file-metadata/dist/filepond-plugin-file-metadata.min.js"
            asp-append-version="true"></script>
    <script src="~/lib/filepond/filepond.min.js"
            asp-append-version="true"></script>
    <script>
            (function () {
                // ── Encode path to elFinder hash ──────────────────────────
                function encodePath(path) {
                    var trimmed = path.replace(/^\//, '');
                    var encoded = btoa(unescape(encodeURIComponent(trimmed)))
                        .replace(/\+/g, '-')
                        .replace(/\//g, '_')
                        .replace(/=+$/, '');
                    return 'l1_' + encoded;
                }

                function decodePath(hash) {
                    if (!hash || hash.indexOf('l1_') !== 0) {
                        return null;
                    }

                    var encoded = hash.substring(3)
                        .replace(/-/g, '+')
                        .replace(/_/g, '/');

                    while (encoded.length % 4 !== 0) {
                        encoded += '=';
                    }

                    try {
                        var decoded = decodeURIComponent(escape(atob(encoded)));
                        return normalizePath('/' + decoded);
                    } catch {
                        return null;
                    }
                }

                function normalizePath(path) {
                    if (!path) {
                        return '/pub';
                    }

                    var clean = path.replace(/\\/g, '/').replace(/\/+/g, '/');
                    if (clean.charAt(0) !== '/') {
                        clean = '/' + clean;
                    }

                    if (clean.length > 1 && clean.endsWith('/')) {
                        clean = clean.substring(0, clean.length - 1);
                    }

                    return clean;
                }

                function updateUploadStatus(message) {
                    var status = document.getElementById('ccmsUploadStatus');
                    if (!status) {
                        return;
                    }

                    status.textContent = message;
                }

                function updateReadyUploadStatus() {
                    updateUploadStatus('Ready to upload to ' + currentUploadPathDisplay);
                }

                function expandPond() {
                    var bar = document.querySelector('.ccms-upload-bar');
                    if (!bar) {
                        return;
                    }

                    if (autoCollapseHandle) {
                        clearTimeout(autoCollapseHandle);
                        autoCollapseHandle = null;
                    }

                    bar.classList.remove('ccms-pond-closing');
                    bar.classList.add('ccms-pond-active');
                }

                function collapsePond() {
                    var bar = document.querySelector('.ccms-upload-bar');
                    if (!bar || !bar.classList.contains('ccms-pond-active')) {
                        return;
                    }

                    bar.classList.add('ccms-pond-closing');

                    setTimeout(function () {
                        bar.classList.remove('ccms-pond-active', 'ccms-pond-closing');
                    }, 190);
                }

                function refreshElFinderFolder() {
                    if (elFinderInstance && typeof elFinderInstance.reload === 'function') {
                        elFinderInstance.reload();
                    }
                }

                // ── Starting target hash ──────────────────────────────────
                var startTarget = encodePath('@Html.Raw(target)');
                var currentUploadPath = normalizePath('@Html.Raw(target)');
                var currentUploadPathDisplay = currentUploadPath;
                var elFinderInstance = null;
                var pond = null;
                var autoCollapseHandle = null;

                // Tracks serverId → filename so the revert call can reconstruct the DELETE URL.
                var pondFileMap = new Map();

                // ── File-selection callback (selectOne / imagesOnly) ──────
                var pickCallback = null;

        @if (selectOne || imagesOnly)
        {
                    <text>
                        pickCallback = function (file) {
                            var url = file.url || '';
                            if (typeof window.parent !== 'undefined') {
                                if (typeof window.parent.CCMS___FileManagerPick === 'function') {
                                    window.parent.CCMS___FileManagerPick(url);
                                } else if (typeof window.parent.selectImage === 'function') {
                                    window.parent.selectImage(url);
                                }
                            }
                        };
                    </text>
        }

                // ── elFinder initialisation ───────────────────────────────
                var efOptions = {
                    url: '@connectorUrl',
                    lang: 'en',
                    themes : {
                        'mt-darkblue' : '../elfinder-material-theme/manifests/darkblue.json?v=2',
                        'mt-gray'     : '../elfinder-material-theme/manifests/gray.json?v=2',
                        'mt-light'    : '../elfinder-material-theme/manifests/light.json?v=2',
                    },
                    theme: 'mt-gray',
                    resizable: false,
                    baseUrl: '/lib/elfinder/',
                    commands: ['*', '!upload'],
                    uiOptions: {
                        toolbar: [
                            ['back', 'forward'],
                            ['reload'],
                            ['home', 'up'],
                            ['mkdir', 'mkfile'],
                            ['open', 'download'],
                            ['info'],
                            ['quicklook'],
                            ['copy', 'cut', 'paste'],
                            ['rm'],
                            ['rename'],
                            ['search'],
                            ['view', 'sort']
                        ],
                    },
                    startPathHash: startTarget,
                    handlers: {
                        open: function (event) {
                            var cwd = null;

                            if (event && event.data && event.data.cwd && event.data.cwd.hash) {
                                cwd = decodePath(event.data.cwd.hash);
                            }

                            if (!cwd && elFinderInstance && typeof elFinderInstance.cwd === 'function') {
                                var active = elFinderInstance.cwd();
                                if (active && active.hash) {
                                    cwd = decodePath(active.hash);
                                }
                            }

                            if (cwd) {
                                currentUploadPath = cwd;

                                if (event && event.data && event.data.cwd && event.data.cwd.options && event.data.cwd.options.path) {
                                    currentUploadPathDisplay = normalizePath('/' + event.data.cwd.options.path);
                                } else {
                                    currentUploadPathDisplay = cwd;
                                }

                                updateReadyUploadStatus();
                            }
                        },
                        error: function (event) {
                            var err = event.data && event.data.error;
                            if (window.console && err) { console.warn('[elFinder]', err); }
                        }
                    }
                };

        @if (directoryOnly)
        {
                    <text>
                        efOptions.commandsOptions = { open: { dirs: true } };
                        efOptions.onlyMimes = ['directory'];
                    </text>
        }
        @if (imagesOnly)
        {
                    <text>
                        efOptions.onlyMimes = ['image'];
                    </text>
        }
                if (pickCallback !== null) {
                    efOptions.getFileCallback = pickCallback;
                }

                if (typeof $.fn.elfinder !== 'function') {
                    $('#ccmsElFinder').html('<div class="alert alert-danger" role="alert">File manager failed to load. Please refresh or contact support.</div>');
                    if (window.console) {
                        console.error('[elFinder] Plugin did not load. Check CDN/network access.');
                    }

                    return;
                }

                elFinderInstance = $('#ccmsElFinder').elfinder(efOptions).elfinder('instance');

                if (elFinderInstance && typeof elFinderInstance.cwd === 'function') {
                    var initialCwd = elFinderInstance.cwd();
                    if (initialCwd && initialCwd.hash) {
                        var decodedStart = decodePath(initialCwd.hash);
                        if (decodedStart) {
                            currentUploadPath = decodedStart;
                        }

                        if (initialCwd.options && initialCwd.options.path) {
                            currentUploadPathDisplay = normalizePath('/' + initialCwd.options.path);
                        }
                    }
                }

                updateReadyUploadStatus();

                var inputElement = document.getElementById('ccmsFilepond');
                if (!inputElement || typeof FilePond === 'undefined') {
                    return;
                }

                if (typeof FilePondPluginFileMetadata !== 'undefined') {
                    FilePond.registerPlugin(FilePondPluginFileMetadata);
                }

                pond = FilePond.create(inputElement, {
                    dropOnPage: true,
                    dropOnElement: false,
                    chunkUploads: true,
                    chunkSize: 5242880,
                    chunkForce: true,
                    credits: false,
                    instantUpload: true,
                    labelIdle: 'Drop files anywhere or <span class="filepond--label-action">Browse</span>',
                    server: {
                        process: '@Url.Action("Process", "FileManager")',
                        patch: '@Url.Action("Process", "FileManager")',
                        revert: function (uniqueFileId, load, error) {
                            var filename = pondFileMap.get(uniqueFileId);
                            if (!filename) {
                                load();
                                return;
                            }

                            fetch('@Url.Action("Process", "FileManager")?fileName=' + encodeURIComponent(filename), {
                                method: 'DELETE',
                                headers: { 'Content-Type': 'text/plain' },
                                body: uniqueFileId
                            }).then(function (response) {
                                if (response.ok) {
                                    pondFileMap.delete(uniqueFileId);
                                    refreshElFinderFolder();
                                    load();
                                } else {
                                    error('Revert failed: ' + response.status);
                                }
                            }).catch(function (err) {
                                error('Revert error: ' + err);
                            });
                        }
                    }
                });

                pond.on('addfile', function (error, file) {
                    if (error) {
                        updateUploadStatus('Upload preparation failed');
                        return;
                    }

                    file.setMetadata('path', currentUploadPath);
                    file.setMetadata('relativePath', file.relativePath || file.filename);
                    file.setMetadata('fileName', file.filename);

                    expandPond();
                    updateUploadStatus('Uploading ' + file.filename + '...');
                });

                pond.on('processfilestart', function (file) {
                    updateUploadStatus('Uploading ' + file.filename + '...');
                });

                pond.on('processfile', function (error, file) {
                    if (error) {
                        updateUploadStatus('Upload failed for ' + file.filename);
                        if (autoCollapseHandle) {
                            clearTimeout(autoCollapseHandle);
                            autoCollapseHandle = null;
                        }
                        return;
                    }

                    // Record serverId → filename so revert can build the DELETE URL.
                    if (file.serverId) {
                        pondFileMap.set(file.serverId, file.filename);
                    }

                    updateUploadStatus('Uploaded ' + file.filename + ' to ' + currentUploadPathDisplay);
                });

                pond.on('processfiles', function () {
                    refreshElFinderFolder();
                    updateReadyUploadStatus();

                    if (autoCollapseHandle) {
                        clearTimeout(autoCollapseHandle);
                    }

                    autoCollapseHandle = setTimeout(function () {
                        collapsePond();
                        autoCollapseHandle = null;
                    }, 2500);
                });

                var browseButton = document.getElementById('ccmsUploadBrowseBtn');
                if (browseButton) {
                    browseButton.addEventListener('click', function () {
                        if (pond && typeof pond.browse === 'function') {
                            pond.browse();
                            return;
                        }

                        inputElement.click();
                    });
                }

                var dismissButton = document.getElementById('ccmsPondDismissBtn');
                if (dismissButton) {
                    dismissButton.addEventListener('click', function () {
                        collapsePond();
                    });
                }
            })();
    </script>
}
