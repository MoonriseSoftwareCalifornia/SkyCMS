@model Sky.Editor.Services.Templates.Models.TemplateApplicationPreview
@{
    ViewData["Title"] = "Preview Template Impact";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2>Preview Template Impact: @Model.TemplateName</h2>
            <p class="lead">Review which articles will be affected by applying this template.</p>
        </div>
    </div>

    @if (Model.TotalAffectedArticles == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            No articles are currently using this template.
        </div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-12">
                <div class="alert @(Model.AllArticlesSafe ? "alert-success" : "alert-warning")">
                    <h4>
                        @if (Model.AllArticlesSafe)
                        {
                            <i class="bi bi-check-circle"></i> @:All articles can be safely updated
                        }
                        else
                        {
                            <i class="bi bi-exclamation-triangle"></i> @:Some articles may lose content
                        }
                    </h4>
                    <ul class="mb-0">
                        <li><strong>Total affected articles:</strong> @Model.TotalAffectedArticles</li>
                        <li><strong>Articles with warnings:</strong> @Model.WarningCount</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Affected Articles</h3>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Article #</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Version</th>
                                    <th>Editable Regions</th>
                                    <th>Warnings</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var article in Model.Articles.OrderBy(a => a.ArticleNumber))
                                {
                                    <tr class="@(!article.CanMerge || !string.IsNullOrEmpty(article.MergeWarning) ? "table-warning" : "")">
                                        <td>@article.ArticleNumber</td>
                                        <td>@article.Title</td>
                                        <td>
                                            @if (article.HasPublishedVersion)
                                            {
                                                <span class="badge bg-success">Published</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Draft</span>
                                            }
                                        </td>
                                        <td>v@article.CurrentVersionNumber</td>
                                        <td>@article.EditableRegionsCount</td>
                                        <td>
                                            @if (!article.CanMerge)
                                            {
                                                <span class="badge bg-danger">Cannot merge</span>
                                            }
                                            else if (!string.IsNullOrEmpty(article.MergeWarning))
                                            {
                                                <i class="bi bi-exclamation-triangle text-warning" 
                                                   title="@article.MergeWarning"></i>
                                                <small class="text-muted">@article.MergeWarning</small>
                                            }
                                            else
                                            {
                                                <span class="text-success">? Safe</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="d-flex justify-content-between">
                    <a href="@Url.Action("Pages", new { id = Model.TemplateId })" 
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Articles
                    </a>
                    
                    @if (Model.AllArticlesSafe || Model.WarningCount < Model.TotalAffectedArticles)
                    {
                        <div>
                            <a href="@Url.Action("Publish", new { id = Model.TemplateId })" 
                               class="btn btn-primary"
                               onclick="return confirm('This will create draft versions for @Model.TotalAffectedArticles articles. Continue?');">
                                <i class="bi bi-check-circle"></i> Apply to All Articles
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (!Model.AllArticlesSafe)
        {
            <div class="row mt-3">
                <div class="col-12">
                    <div class="alert alert-warning">
                        <h5><i class="bi bi-info-circle"></i> Important Notes:</h5>
                        <ul class="mb-0">
                            <li>Articles with warnings may lose content in editable regions that don't exist in the new template.</li>
                            <li>Applying the template will create <strong>draft versions</strong> - published articles remain unchanged until you publish the drafts.</li>
                            <li>You can review each draft before publishing it.</li>
                            <li>Consider backing up important content before applying.</li>
                        </ul>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Styles {
    <style>
        .table td {
            vertical-align: middle;
        }
        .bi {
            margin-right: 0.25rem;
        }
    </style>
}
