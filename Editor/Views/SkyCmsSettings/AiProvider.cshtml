@using Sky.Editor.Models
@model CopilotProxyOptions

@{
    ViewData["Title"] = "AI Provider Settings";
    var operation = ViewData["Operation"] as string;
}

<style>
    .text-danger {
        color: white !important;
        font-style: italic !important;
        font-weight: bold !important;
    }
</style>

<div class="pt-3">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card pb-4 bg-dark text-light">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                    <p>Configure the server-side proxy used for code editor AI completions.</p>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(operation))
                    {
                        <div class="alert alert-success" role="alert">
                            AI provider settings saved.
                        </div>
                    }

                    <form id="copilotProxyForm" method="post" asp-action="AiProvider" asp-controller="SkyCmsSettings">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="providerPreset">Provider Preset</label>
                            <select id="providerPreset" class="form-select">
                                <option value="custom" selected>Custom (do not change current values)</option>
                                <option value="copilot">Copilot (GitHub Models)</option>
                                <option value="openai">OpenAI API</option>
                                <option value="azureai">Azure AI (Azure OpenAI)</option>
                            </select>
                            <span class="text-muted">Choosing a preset fills endpoint/model/timeout/temperature/max tokens. Access token is never auto-filled.</span>
                        </div>

                        <div class="mb-3">
                            <span class="d-block mb-1">Token documentation:</span>
                            <a href="https://docs.github.com/en/copilot/how-tos/provide-context/use-github-models/prototyping-with-ai-models" target="_blank" rel="noopener noreferrer" class="d-block">Copilot / GitHub Models token docs</a>
                            <a href="https://platform.openai.com/docs/quickstart#create-and-export-an-api-key" target="_blank" rel="noopener noreferrer" class="d-block">OpenAI API key docs</a>
                            <a href="https://learn.microsoft.com/azure/ai-services/openai/how-to/create-resource?pivots=web-portal" target="_blank" rel="noopener noreferrer" class="d-block">Azure OpenAI key docs</a>
                        </div>

                        <div class="mb-3 form-check form-switch">
                            <input class="form-check-input" asp-for="Enabled" type="checkbox" />
                            <label asp-for="Enabled" class="form-check-label"></label>
                            <span asp-validation-for="Enabled" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Endpoint"></label>
                            <input asp-for="Endpoint" class="form-control"
                                   placeholder="Choose an endpoint or type in a new one." aria-required="true" autocomplete="off" />
                            <span class="text-muted">OpenAI-compatible chat completions endpoint URL.</span>
                            <span asp-validation-for="Endpoint" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Model"></label>
                            <input asp-for="Model" class="form-control" aria-required="true" />
                            <span asp-validation-for="Model" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AccessToken"></label>
                            <input asp-for="AccessToken" type="password" class="form-control" aria-required="true" autocomplete="new-password" />
                            <span class="text-muted">Stored in the SkyCMS settings table and sent as a bearer token to the upstream provider.</span>
                            <span asp-validation-for="AccessToken" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="TimeoutMs"></label>
                                <input asp-for="TimeoutMs" class="form-control" type="number" min="1000" max="60000" />
                                <span asp-validation-for="TimeoutMs" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Temperature"></label>
                                <input asp-for="Temperature" class="form-control" type="number" step="0.1" min="0" max="2" />
                                <span asp-validation-for="Temperature" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="MaxTokens"></label>
                                <input asp-for="MaxTokens" class="form-control" type="number" min="16" max="1024" />
                                <span asp-validation-for="MaxTokens" class="text-danger"></span>
                            </div>
                        </div>

                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <button id="btnSave" type="submit" class="btn btn-sm btn-primary">Save settings <i class="fa-solid fa-circle-arrow-right"></i></button>
                        <a asp-action="Index" asp-controller="SkyCmsSettings" class="btn btn-sm btn-secondary">Done <i class="fa-solid fa-circle-arrow-right"></i></a>
                        <a asp-action="RemoveAiProvider" asp-controller="SkyCmsSettings" class="btn btn-sm btn-outline-danger">Remove settings <i class="fa-solid fa-circle-arrow-right"></i></a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("body").addClass("cwps-editor-container");

        const endpointSuggestions = [
            {
                label: "GitHub Models (Azure) w/Chat",
                value: "https://models.inference.ai.azure.com/chat/completions"
            },
            {
                label: "OpenAI API w/Chat",
                value: "https://api.openai.com/v1/chat/completions"
            },
            {
                label: "Azure OpenAI (replace <> in URL with your values)",
                value: "https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-02-01"
            },
            {
                label: "Local (Ollama)",
                value: "http://localhost:11434/v1/chat/completions"
            },
        ];

        const providerPresets = {
            copilot: {
                endpoint: "https://models.inference.ai.azure.com/chat/completions",
                model: "gpt-4o-mini",
                timeoutMs: 30000,
                temperature: 0.2,
                maxTokens: 512
            },
            openai: {
                endpoint: "https://api.openai.com/v1/chat/completions",
                model: "gpt-4o-mini",
                timeoutMs: 30000,
                temperature: 0.2,
                maxTokens: 512
            },
            azureai: {
                endpoint: "https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-02-01",
                model: "<deployment>",
                timeoutMs: 30000,
                temperature: 0.2,
                maxTokens: 512
            }
        };

        const $endpoint = $("#Endpoint");
        const $model = $("#Model");
        const $timeoutMs = $("#TimeoutMs");
        const $temperature = $("#Temperature");
        const $maxTokens = $("#MaxTokens");
        const $providerPreset = $("#providerPreset");

        if ($providerPreset.length) {
            $providerPreset.on("change", function () {
                const selected = $(this).val();
                const preset = providerPresets[selected];
                if (!preset) {
                    return;
                }

                $endpoint.val(preset.endpoint);
                $model.val(preset.model);
                $timeoutMs.val(preset.timeoutMs);
                $temperature.val(preset.temperature);
                $maxTokens.val(preset.maxTokens);
            });
        }

        if ($endpoint.length) {
            $endpoint.autocomplete({
                minLength: 0,
                source: function (request, response) {
                    const term = (request.term || "").toLowerCase();
                    const matches = endpointSuggestions.filter(item =>
                        item.label.toLowerCase().includes(term)
                        || item.value.toLowerCase().includes(term));
                    response(matches);
                },
                focus: function (event, ui) {
                    $endpoint.val(ui.item.value);
                    return false;
                },
                select: function (event, ui) {
                    $endpoint.val(ui.item.value);
                    return false;
                }
            }).autocomplete("instance")._renderItem = function (ul, item) {
                return $("<li>")
                    .append($("<div>")
                        .append($("<div>").text(item.label))
                        .append($("<small>").addClass("text-muted").text(item.value)))
                    .appendTo(ul);
            };

            $endpoint.on("focus", function () {
                $(this).autocomplete("search", $(this).val());
            });
        }
    });
</script>

<partial name="_ValidationScriptsPartial" />
