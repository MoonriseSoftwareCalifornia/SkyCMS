@using Sky.Editor.Models
@model CopilotProxyOptions

@{
    ViewData["Title"] = "AI Provider Settings";
    var operation = ViewData["Operation"] as string;
}

<style>
    .text-danger {
        color: white !important;
        font-style: italic !important;
        font-weight: bold !important;
    }

    .ai-preview-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
        font-size: 0.85rem;
    }

    .ai-preview-status-badge {
        display: inline-block;
        padding: 0.1rem 0.45rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        background: rgba(255, 255, 255, 0.14);
        color: #fff;
        letter-spacing: 0.02em;
    }
</style>

<div class="pt-3">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card pb-4 bg-dark text-light">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                    <p>Configure the server-side proxy used for code editor AI completions.</p>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(operation))
                    {
                        <div class="alert alert-success" role="alert">
                            AI provider settings saved.
                        </div>
                    }

                    <form id="copilotProxyForm" method="post" asp-action="AiProvider" asp-controller="SkyCmsSettings">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="providerPreset">Provider Preset</label>
                            <select id="providerPreset" class="form-select">
                                <option value="custom" selected>Custom (do not change current values)</option>
                                <option value="copilot">Copilot (GitHub Models)</option>
                                <option value="openai">OpenAI API</option>
                                <option value="azureai">Azure AI (Azure OpenAI)</option>
                            </select>
                            <span class="text-muted">Choosing a preset fills endpoint/model/timeout/temperature/max tokens. Access token is never auto-filled. OpenAI and GitHub Models presets now default to SkyCMS auto mode.</span>
                        </div>

                        <div class="mb-3">
                            <span class="d-block mb-1">Token documentation:</span>
                            <a href="https://docs.github.com/en/copilot/how-tos/provide-context/use-github-models/prototyping-with-ai-models" target="_blank" rel="noopener noreferrer" class="d-block">Copilot / GitHub Models token docs</a>
                            <a href="https://platform.openai.com/docs/quickstart#create-and-export-an-api-key" target="_blank" rel="noopener noreferrer" class="d-block">OpenAI API key docs</a>
                            <a href="https://learn.microsoft.com/azure/ai-services/openai/how-to/create-resource?pivots=web-portal" target="_blank" rel="noopener noreferrer" class="d-block">Azure OpenAI key docs</a>
                        </div>

                        <div class="mb-3 form-check form-switch">
                            <input class="form-check-input" asp-for="Enabled" type="checkbox" />
                            <label asp-for="Enabled" class="form-check-label"></label>
                            <span asp-validation-for="Enabled" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Endpoint"></label>
                            <input asp-for="Endpoint" class="form-control"
                                   placeholder="Choose an endpoint or type in a new one." aria-required="true" autocomplete="off" />
                            <span class="text-muted">OpenAI-compatible chat completions endpoint URL.</span>
                            <span asp-validation-for="Endpoint" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Model"></label>
                            <input asp-for="Model" class="form-control" aria-required="true" placeholder="auto, gpt-4o-mini, openai/gpt-4.1, or an Azure deployment name" />
                            <span class="text-muted">Use <strong>auto</strong> for SkyCMS-managed defaults. Azure OpenAI usually uses the deployment name already embedded in the endpoint URL.</span>
                            <span asp-validation-for="Model" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="providerModelCatalogSelect">Discovered models</label>
                            <div class="d-flex gap-2">
                                <select id="providerModelCatalogSelect" class="form-select" disabled>
                                    <option value="">Load provider models from the current endpoint and token</option>
                                </select>
                                <button id="btnLoadProviderModels" type="button" class="btn btn-sm btn-outline-light">Load models</button>
                            </div>
                            <div id="providerPreviewStatus" class="ai-preview-status" style="display:none">
                                <span id="providerPreviewStatusBadge" class="ai-preview-status-badge">Preview</span>
                                <span id="providerPreviewStatusText" class="text-muted"></span>
                            </div>
                            <span id="providerModelCatalogHelp" class="text-muted d-block mt-1">Preview model choices using the current form values before saving. Unsupported providers will keep using the freeform model field.</span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AccessToken"></label>
                            <input asp-for="AccessToken" type="password" class="form-control" aria-required="true" autocomplete="new-password" />
                            <span class="text-muted">Stored in the SkyCMS settings table and sent as a bearer token for OpenAI-compatible endpoints, or as an api-key header for Azure OpenAI endpoints.</span>
                            <span asp-validation-for="AccessToken" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="TimeoutMs"></label>
                                <input asp-for="TimeoutMs" class="form-control" type="number" min="1000" max="60000" />
                                <span asp-validation-for="TimeoutMs" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Temperature"></label>
                                <input asp-for="Temperature" class="form-control" type="number" step="0.1" min="0" max="2" />
                                <span asp-validation-for="Temperature" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="MaxTokens"></label>
                                <input asp-for="MaxTokens" class="form-control" type="number" min="16" max="1024" />
                                <span asp-validation-for="MaxTokens" class="text-danger"></span>
                            </div>
                        </div>

                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <button id="btnSave" type="submit" class="btn btn-sm btn-primary">Save settings <i class="fa-solid fa-circle-arrow-right"></i></button>
                        <a asp-action="Index" asp-controller="SkyCmsSettings" class="btn btn-sm btn-secondary">Done <i class="fa-solid fa-circle-arrow-right"></i></a>
                        <a asp-action="RemoveAiProvider" asp-controller="SkyCmsSettings" class="btn btn-sm btn-outline-danger">Remove settings <i class="fa-solid fa-circle-arrow-right"></i></a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("body").addClass("cwps-editor-container");

        const endpointSuggestions = [
            {
                label: "GitHub Models (Azure) w/Chat",
                value: "https://models.inference.ai.azure.com/chat/completions"
            },
            {
                label: "OpenAI API w/Chat",
                value: "https://api.openai.com/v1/chat/completions"
            },
            {
                label: "Azure OpenAI (replace <> in URL with your values)",
                value: "https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-02-01"
            },
            {
                label: "Local (Ollama)",
                value: "http://localhost:11434/v1/chat/completions"
            },
        ];

        const providerPresets = {
            copilot: {
                endpoint: "https://models.inference.ai.azure.com/chat/completions",
                model: "auto",
                timeoutMs: 30000,
                temperature: 0.2,
                maxTokens: 512
            },
            openai: {
                endpoint: "https://api.openai.com/v1/chat/completions",
                model: "auto",
                timeoutMs: 30000,
                temperature: 0.2,
                maxTokens: 512
            },
            azureai: {
                endpoint: "https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-02-01",
                model: "<deployment>",
                timeoutMs: 30000,
                temperature: 0.2,
                maxTokens: 512
            }
        };

        const $endpoint = $("#Endpoint");
        const $model = $("#Model");
        const $timeoutMs = $("#TimeoutMs");
        const $temperature = $("#Temperature");
        const $maxTokens = $("#MaxTokens");
        const $providerPreset = $("#providerPreset");
        const $accessToken = $("#AccessToken");
        const $catalogSelect = $("#providerModelCatalogSelect");
        const $catalogHelp = $("#providerModelCatalogHelp");
        const $loadModels = $("#btnLoadProviderModels");
        const $previewStatus = $("#providerPreviewStatus");
        const $previewStatusBadge = $("#providerPreviewStatusBadge");
        const $previewStatusText = $("#providerPreviewStatusText");
        const previewEndpoint = '@Url.Action("PreviewAiProviderModels", "SkyCmsSettings")';

        function getAntiForgeryToken() {
            return $('input[name="__RequestVerificationToken"]').val() || '';
        }

        function clearModelCatalog(message) {
            if (!$catalogSelect.length) {
                return;
            }

            $catalogSelect.empty();
            $catalogSelect.append($('<option>', {
                value: '',
                text: 'Load provider models from the current endpoint and token'
            }));
            $catalogSelect.prop('disabled', true);
            $previewStatus.hide();
            $previewStatusText.text('');
            $catalogHelp.text(message || 'Preview model choices using the current form values before saving. Unsupported providers will keep using the freeform model field.');
        }

        function updatePreviewStatus(response) {
            if (!$previewStatus.length) {
                return;
            }

            const usedFreshLoad = !!(response && (response.usedFreshLoad ?? response.UsedFreshLoad));
            const previewLoadLabel = (response && (response.previewLoadLabel ?? response.PreviewLoadLabel)) || (usedFreshLoad ? 'Fresh provider read' : 'Cached provider result');
            const discoveryState = (response && (response.discoveryState ?? response.DiscoveryState)) || 'unsupported';

            $previewStatusBadge.text(previewLoadLabel);
            $previewStatusText.text(`Discovery state: ${discoveryState}`);
            $previewStatus.show();
        }

        function appendCatalogOption(value, text, selected) {
            $catalogSelect.append($('<option>', {
                value: value,
                text: text,
                selected: !!selected
            }));
        }

        function updateModelCatalog(response) {
            const supportsSelection = !!(response && (response.supportsUserModelSelection ?? response.SupportsUserModelSelection));
            const supportsAutoMode = !!(response && (response.supportsAutoMode ?? response.SupportsAutoMode));
            const discoveryState = (response && (response.discoveryState ?? response.DiscoveryState)) || 'unsupported';
            const discoveryStateMessage = (response && (response.discoveryStateMessage ?? response.DiscoveryStateMessage)) || '';
            const models = response && (response.models ?? response.Models) ? (response.models ?? response.Models) : [];
            const discoveryError = response && (response.discoveryError ?? response.DiscoveryError);
            const defaultSelectionLabel = (response && (response.defaultSelectionLabel ?? response.DefaultSelectionLabel)) || 'Default';
            const effectiveModel = response && (response.effectiveModel ?? response.EffectiveModel);
            const currentModel = ($model.val() || '').trim();
            let matchedCurrentModel = false;

            updatePreviewStatus(response);

            $catalogSelect.empty();

            if (discoveryState === 'inferred' && models.length > 0) {
                models.forEach((modelOption) => {
                    const modelId = modelOption.id ?? modelOption.Id ?? '';
                    const displayName = modelOption.displayName ?? modelOption.DisplayName ?? modelId;
                    appendCatalogOption(modelId, `${displayName} (inferred from endpoint)`, modelId.toLowerCase() === currentModel.toLowerCase());
                });

                $catalogSelect.prop('disabled', true);
                $catalogHelp.text(discoveryStateMessage || 'SkyCMS inferred the active model from the current endpoint.');
                return;
            }

            if (!supportsSelection || models.length === 0) {
                clearModelCatalog(discoveryStateMessage || discoveryError || defaultSelectionLabel);
                return;
            }

            appendCatalogOption(supportsAutoMode ? 'auto' : (effectiveModel || ''), defaultSelectionLabel, currentModel.length === 0 || (supportsAutoMode && currentModel.toLowerCase() === 'auto'));

            models.forEach((modelOption) => {
                const modelId = modelOption.id ?? modelOption.Id ?? '';
                const displayName = modelOption.displayName ?? modelOption.DisplayName ?? modelId;
                const recommended = !!(modelOption.recommended ?? modelOption.Recommended);
                const publisher = modelOption.publisher ?? modelOption.Publisher;
                const optionLabel = recommended
                    ? `${displayName} (recommended)`
                    : (publisher ? `${displayName} (${publisher})` : displayName);
                const isSelected = currentModel.length > 0 && modelId.toLowerCase() === currentModel.toLowerCase();
                matchedCurrentModel = matchedCurrentModel || isSelected;
                appendCatalogOption(modelId, optionLabel, isSelected);
            });

            if (currentModel.length > 0 && currentModel.toLowerCase() !== 'auto' && !matchedCurrentModel) {
                appendCatalogOption(currentModel, `${currentModel} (current custom value)`, true);
            }

            $catalogSelect.prop('disabled', false);
            $catalogHelp.text(discoveryStateMessage || discoveryError || 'Selecting a discovered model writes it back into the saved Model field. Choose the default option to keep provider default behavior.');
        }

        async function loadProviderModels() {
            const token = getAntiForgeryToken();

            $loadModels.prop('disabled', true);
            $previewStatus.hide();
            $catalogHelp.text('Loading provider models...');

            try {
                const response = await fetch(previewEndpoint, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        endpoint: $endpoint.val(),
                        model: $model.val(),
                        accessToken: $accessToken.val(),
                        forceRefresh: true
                    })
                });

                const data = await response.json().catch(() => null);
                if (!response.ok || !data) {
                    clearModelCatalog('The provider model catalog could not be loaded from the current form values.');
                    return;
                }

                updateModelCatalog(data);
            } catch (error) {
                clearModelCatalog('The provider model catalog could not be loaded from the current form values.');
            } finally {
                $loadModels.prop('disabled', false);
            }
        }

        if ($providerPreset.length) {
            $providerPreset.on("change", function () {
                const selected = $(this).val();
                const preset = providerPresets[selected];
                if (!preset) {
                    return;
                }

                $endpoint.val(preset.endpoint);
                $model.val(preset.model);
                $timeoutMs.val(preset.timeoutMs);
                $temperature.val(preset.temperature);
                $maxTokens.val(preset.maxTokens);
                clearModelCatalog('Preset updated. Load models again to preview choices for the new endpoint.');
            });
        }

        if ($loadModels.length) {
            $loadModels.on('click', async function () {
                await loadProviderModels();
            });
        }

        if ($catalogSelect.length) {
            $catalogSelect.on('change', function () {
                const selectedValue = $(this).val();
                if (selectedValue) {
                    $model.val(selectedValue);
                }
            });
        }

        [$endpoint, $model, $accessToken].forEach(($field) => {
            if ($field && $field.length) {
                $field.on('input', function () {
                    clearModelCatalog('Model preview reflects the current endpoint, token, and model values. Reload after changes.');
                });
            }
        });

        if ($endpoint.length) {
            $endpoint.autocomplete({
                minLength: 0,
                source: function (request, response) {
                    const term = (request.term || "").toLowerCase();
                    const matches = endpointSuggestions.filter(item =>
                        item.label.toLowerCase().includes(term)
                        || item.value.toLowerCase().includes(term));
                    response(matches);
                },
                focus: function (event, ui) {
                    $endpoint.val(ui.item.value);
                    return false;
                },
                select: function (event, ui) {
                    $endpoint.val(ui.item.value);
                    return false;
                }
            }).autocomplete("instance")._renderItem = function (ul, item) {
                return $("<li>")
                    .append($("<div>")
                        .append($("<div>").text(item.label))
                        .append($("<small>").addClass("text-muted").text(item.value)))
                    .appendTo(ul);
            };

            $endpoint.on("focus", function () {
                $(this).autocomplete("search", $(this).val());
            });
        }

        clearModelCatalog();
    });
</script>

<partial name="_ValidationScriptsPartial" />
