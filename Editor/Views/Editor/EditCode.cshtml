@using Cosmos.Cms.Common
@using Newtonsoft.Json
@model EditCodePostModel
@{
    Layout = "_LayoutEditor";
    ViewData["Title"] = $"Editing '{Model.Title}' with the Code Editor.";
    var fields = Model.EditorFields.ToArray();
    
    // Pass content to the save form partial via ViewData
    ViewData["Content"] = Model.Content;
    ViewData["HeadJavaScript"] = Model.HeadJavaScript;
    ViewData["FooterJavaScript"] = Model.FooterJavaScript;
}

<partial name="_CodeEditorShared" model="Model" />

<form id="frmSave" autocomplete="off">
    @Html.AntiForgeryToken()
    <partial name="_EditorSaveForm" model="new Sky.Cms.Models.EditPostViewModel {
        Id = Model.Id,
        ArticleNumber = Model.ArticleNumber,
        VersionNumber = Model.VersionNumber,
        Title = Model.Title,
        UrlPath = Model.UrlPath,
        Published = Model.Published,
        Updated = Model.Updated,
        BannerImage = Model.BannerImage,
        SaveAsNewVersion = false
    }" />
</form>

@if (Model != null)
{
    <div class="modal" id="versionList" tabindex="-2">
        <div class="modal-dialog">
            <div class="modal-header">
                <h5 class="modal-title">Article Versions</h5>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
}

<!-- Shared error modal -->
<partial name="_EditorErrorModal" />

<!-- Include shared editor infrastructure -->
<partial name="_EditorCommonScripts" />

<script>
    // View-specific constants
    const versionNumber = @Model.VersionNumber;
    const hasModel = @((Model != null).ToString().ToLower());
    
    // Initialize editFields from model
    var editFields = @Html.Raw(JsonConvert.SerializeObject(Model.EditorFields));

    // Editor context for AI assistant
    window.ccmsEditorContext = {
        documentKind: '@(Model.ArticleType.ToString() == "BlogPost" ? "blog" : "article")',
        editorSurface: 'monaco',
        articleType: '@Model.ArticleType',
        category: '@(Model.Category ?? string.Empty)',
        urlPath: '@(Model.UrlPath ?? string.Empty)',
        sectionKindMap: {
            'Content': '@(Model.ArticleType.ToString() == "BlogPost" ? "blog-content" : "article-content")',
            'HeadJavaScript': 'article-head-script',
            'FooterJavaScript': 'article-footer-script'
        }
    };

    // Override afterEditorCreate to add active document tracking
    function afterEditorCreate(fieldInfo) {
        // Check after loading data
        if (typeof checkDisplayLiveEditorButton === 'function') {
            checkDisplayLiveEditorButton('Content');
        }
        // Update active document tracker
        if (window.activeDocumentTracker) {
            window.activeDocumentTracker.setActiveDocument({
                fieldName: fieldInfo.FieldName,
                language: fieldInfo.EditorMode,
                title: '@Model.Title',
                articleNumber: '@Model.ArticleNumber',
                isDirty: false
            });
        }
    }

    // View-specific save function using unified EditorSaveService
    async function saveChanges() {

        if (EditorSaveService.state.saveInProgress === true) {
            return;
        }

        EditorUI.saving();
        
        if (typeof savePublishDateTime === 'function') {
            savePublishDateTime();
        }

        // Save current editor content
        if (window.monacoEditorCore) {
            window.monacoEditorCore.saveCurrentFieldContent();
        } else if (window.editor && window.fieldId) {
            $("#" + fieldId).val(editor.getValue());
        }

        // Copy content buffer into canonical payload
        $("#Payload").val($("#Content").val());

        await EditorSaveService.ensureEncryptionContext();

        let model = {
            ArticleNumber: $("#ArticleNumber").val(),
            VersionNumber: $("#VersionNumber").val(),
            Title: $("#Title").val(),
            Published: "",
            Updated: $("#Updated").val(),
            Payload: $("#Payload").val(),
            HeadJavaScript: $("#HeadJavaScript").val(),
            FooterJavaScript: $("#FooterJavaScript").val(),
            EditingField: $("#EditingField").val(),
            UrlPath: $("#UrlPath").val(),
            BannerImage: $("#BannerImage").val(),
            Command: "SaveCode"
        };

        try {
            const response = await EditorSaveService.saveArticle(model, "SaveCode", {
                encryptFields: ['Payload', 'HeadJavaScript', 'FooterJavaScript']
            });

            if (EditorSaveService.handleSaveResponse(response, {
                updateUI: true,
                onSuccess: () => {
                    // Mark document as clean after successful save
                    if (window.activeDocumentTracker) {
                        window.activeDocumentTracker.markClean();
                    }
                    if (typeof checkDisplayLiveEditorButton === 'function') {
                        checkDisplayLiveEditorButton('Content');
                    }
                    if (typeof next !== 'undefined' && next !== null && typeof next === 'function') {
                        next();
                        next = null;
                    }
                    EditorUI.doneSaving();
                },
                onError: (msg) => {
                    EditorUI.showError(msg);
                    EditorUI.doneSaving();
                }
            })) {
                // Success
            } else {
                // Error handled by EditorSaveService.handleSaveResponse
            }
        } catch (error) {
            EditorUI.showError(error.message);
            EditorUI.doneSaving();
        }
    }

    window.CodeEditorShared.registerActiveDocumentDebugListener();

    $(document).ready(async function () {
        await window.CodeEditorShared.initializePage({
            editFields: editFields,
            initialField: "@Model.EditingField",
            onReady: function () {
                $("#btnOtherPages").show();
                $("#btnOpenInsertImage").hide();
                $("#lblTitle").html("Page URL: ");
                $("#modalChgTitleHeader").html("Change page URL: ");
                $("#newTitle").html("New page URL: ");

                if ($("#UrlPath").val() != "root") {
                    $("#divUrlTitleExamples").show();
                }

                $("#spanWorkingVersionNo").html("Working Version: " + versionNumber);
                $("#liBtnVersions").show();
                $("#divTitleGroup").show();
                $("#liInsert").show();
                $("#btnVersions").attr("href", "/Editor/Versions/" + $("#ArticleNumber").val() + "?versionNumber=" + $("#VersionNumber").val());

                if (typeof setupInsertButtonHandlers === 'function') {
                    setupInsertButtonHandlers();
                }

                if (hasModel && typeof isReviewer !== 'undefined' && typeof isAuthor !== 'undefined' &&
                    typeof requiresAuthentication !== 'undefined' &&
                    isReviewer === false && isAuthor === false && requiresAuthentication) {
                    $(".perm").show();
                }

                $("#btnCcmsGrapesJsEditor").show();
            }
        });
    });

    $(document).on("unload", function () {
        window.CodeEditorShared.cleanupOnUnload();
    });
</script>
