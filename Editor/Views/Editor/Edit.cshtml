@using Cosmos.Cms.Common
@model HtmlEditorViewModel
@{
    Layout = "_LayoutEditor";
    ViewData["Title"] = $"Editing '{Model.Title}' with the Visual Editor.";
    var hasPermissionsSet = Model.ArticlePermissions.Any();
}

<form class="d-flex" id="frmSave" autocomplete="off">
    @Html.AntiForgeryToken()
    <partial name="_EditorSaveForm" model="new Sky.Cms.Models.EditPostViewModel {
        Id = Model.Id,
        ArticleNumber = Model.ArticleNumber,
        VersionNumber = Model.VersionNumber,
        Title = Model.Title,
        UrlPath = Model.UrlPath,
        Published = Model.Published,
        Updated = Model.Updated,
        BannerImage = Model.BannerImage,
        SaveAsNewVersion = false
    }" />
</form>

<style>
    .ckeditor-copilot-window {
        position: fixed;
        top: 88px;
        right: 24px;
        z-index: 10000;
        max-height: calc(100vh - 120px);
        box-shadow: 0 18px 48px rgba(0, 0, 0, 0.35);
    }

    .ckeditor-copilot-window.is-hidden {
        display: none;
    }

    .ckeditor-copilot-window.is-minimized {
        width: 320px;
        min-width: 260px;
    }

    .ckeditor-copilot-window.is-minimized .ckeditor-copilot-body {
        display: none;
    }

    .ckeditor-copilot-window .copilot-chat-header {
        cursor: move;
        user-select: none;
    }

    .ckeditor-copilot-window-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ckeditor-copilot-window .copilot-chat-form textarea {
        min-height: 72px;
    }

    @@media (max-width: 768px) {
        .ckeditor-copilot-window {
            left: 12px;
            right: 12px;
            top: 74px;
            width: auto;
            min-width: 0;
            max-width: none;
            max-height: calc(100vh - 92px);
        }
    }
</style>

<iframe id="ccmsContFrame" src="/Editor/CcmsContent/@Model.ArticleNumber" style="position: absolute; top: 52px; width: 100%; margin:0px; padding:0px;z-index:1;" onload="setupFrame()" frameBorder="0" scrolling="yes"></iframe>

<aside id="ckeditorCopilotWindow" class="copilot-chat-panel ckeditor-copilot-window is-hidden" aria-label="AI writing assistant">
    <div id="ckeditorCopilotHeader" class="copilot-chat-header">
        <div>
            <div class="copilot-chat-title">AI Writing Assistant</div>
            <div id="ckeditorCopilotSubtitle" class="copilot-chat-subtitle">Scoped to the current editor region.</div>
        </div>
        <div class="ckeditor-copilot-window-actions">
            <a class="btn btn-sm btn-outline-light" href="/Editor/AiHelp?popup=1" rel="noopener" aria-label="Open AI help chat" onclick="return ccmsOpenAiHelpFloatingWindow('/Editor/AiHelp?popup=1');">Detach</a>
            <button id="btnCkeditorCopilotMinimize" type="button" class="btn btn-sm btn-outline-light" aria-label="Minimize AI assistant">_</button>
            <button id="btnCkeditorCopilotClose" type="button" class="btn btn-sm btn-outline-light" aria-label="Close AI assistant">Close</button>
        </div>
    </div>

    <div class="ckeditor-copilot-body">
        <div class="copilot-chat-actions" role="toolbar" aria-label="AI writing actions">
            <button type="button" class="btn btn-sm btn-secondary" data-copilot-action="improve-selection">Improve selection</button>
            <button type="button" class="btn btn-sm btn-secondary" data-copilot-action="rewrite-selection">Rewrite</button>
            <button type="button" class="btn btn-sm btn-secondary" data-copilot-action="shorten-selection">Shorten</button>
            <button type="button" class="btn btn-sm btn-secondary" data-copilot-action="expand-selection">Expand</button>
            <button type="button" class="btn btn-sm btn-secondary" data-copilot-action="replace-block">Replace block</button>
        </div>

        <div class="copilot-model-row px-3 pt-2">
            <label class="form-label form-label-sm mb-0" for="ckeditorCopilotModelSelect">Model</label>
            <div class="d-flex gap-2">
                <select id="ckeditorCopilotModelSelect" class="form-select form-select-sm" disabled>
                    <option value="">Default</option>
                </select>
                <button id="btnCkeditorRefreshModels" type="button" class="btn btn-sm btn-outline-light">Refresh</button>
            </div>
            <div id="ckeditorCopilotModelHelp" class="copilot-model-help"></div>
        </div>

        <div id="ckeditorCopilotMessages" class="copilot-chat-messages">
            <div class="copilot-chat-empty">Open the assistant from a CKEditor toolbar button to start a region-scoped chat.</div>
        </div>

        <div id="ckeditorCopilotStatus" class="copilot-chat-status" style="display:none"></div>

        <form id="ckeditorCopilotForm" class="copilot-chat-form">
            <label class="visually-hidden" for="ckeditorCopilotInput">Ask AI about this editor region</label>
            <textarea id="ckeditorCopilotInput" class="form-control form-control-sm" rows="4" placeholder="Ask for grammar help, a rewrite, or improved copy for this region."></textarea>
            <div class="copilot-chat-footer">
                <span class="copilot-chat-hint">Enter sends. Shift+Enter adds a new line.</span>
                <div class="d-flex gap-2">
                    <button id="btnCkeditorCopilotClear" type="button" class="btn btn-sm btn-outline-light">Clear</button>
                    <button id="btnCkeditorCopilotSend" type="submit" class="btn btn-sm btn-primary">Send</button>
                </div>
            </div>
        </form>
    </div>
</aside>

<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="linksToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="3000">
        <div class="toast-header">
            <strong class="me-auto">Links are disabled while editing</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<!-- Shared error modal -->
<partial name="_EditorErrorModal" />

@if (Model != null)
{
    <script>
        function setupPreviewFrame() {
            const iframe = document.getElementById("iframePreview");
            const iframeWin = iframe.contentWindow || iframe.contentDocument.parentWindow;
            if (iframeWin.document.body) {
                $("#modalContent").height = 50 + (window.innerHeight - document.getElementById("ccmsNavMenu").clientHeight);
                const contents = $("#iframePreview").contents();
                const anchors = contents.find("a");
                $(anchors).click(function (e) {
                    e.preventDefault();
                });
            }
        }
    </script>
    
    <!-- Full screen modal -->
    <div class="modal fade" id="modalImageCropper" tabindex="-1" aria-labelledby="modalLabel" style="display: none;" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalLabel">Crop the image</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="img-container">
                        <img id="image" src="" class="">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="crop">Crop</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Include shared editor infrastructure -->
<partial name="_EditorCommonScripts" />
<script asp-append-version="true" src="~/js/editors/ckeditor-copilot-chat.js"></script>

<script>
    // Global variables
    var ccms_editor_userid = "@this.Context.User.Identity.Name";
    var hasModel = @((Model != null).ToString().ToLower());

    // This needs global scope, so using var
    var hasPermissionsSet = @hasPermissionsSet.ToString().ToLower();

    // Editor context for AI assistant
    window.ccmsEditorContext = {
        documentKind: '@(Model.ArticleType.ToString() == "BlogPost" ? "blog" : "article")',
        editorSurface: 'ckeditor',
        sectionKind: '@(Model.ArticleType.ToString() == "BlogPost" ? "blog-content" : "article-content")',
        articleNumber: '@Model.ArticleNumber',
        title: '@(Model.Title ?? string.Empty)',
        articleType: '@Model.ArticleType',
        category: '@(Model.Category ?? string.Empty)',
        urlPath: '@(Model.UrlPath ?? string.Empty)'
    };

    if (typeof window.ccmsEnrichEditorContext === 'function') {
        window.ccmsEnrichEditorContext();
    }

    // Editable areas
    // let ccms_editibleAreas = []; // Currently set but not consumed.
    // Signal R Connection
    // let signalRConnection; // Currently unused.

    // Monaco Editor
    let editor;

    // let ckeditorSessions = [ ]; // Currently unused.

    // let lockedEditors = [ ]; // Currently write-only in current flow.

    // CK Editor
    let ckeditor = null;
    // Explicitly set on window object for iframe accessibility
    window.enableAutoSave = true;

    // Local backup recovery settings
    const backupMaxAgeMs = 72 * 60 * 60 * 1000; // 72 hours
    let pendingBackupModel = null;

    // Modals
    const linksToast = new bootstrap.Toast(document.getElementById('linksToast'));

    function openCkEditorCopilot(ed) {
        if (!window.ckeditorCopilotChat || typeof window.ckeditorCopilotChat.open !== 'function') {
            alert("Error: Could not open the AI writing assistant.");
            return;
        }

        window.ckeditorCopilotChat.open(ed);
    }

    $("#frmSave").submit(function (e) {
        e.preventDefault();
        saveChanges();
    });

    function getFrameEditors() {
        const iframe = document.getElementById("ccmsContFrame");
        if (!iframe || !iframe.contentWindow || !Array.isArray(iframe.contentWindow.ccms_editors)) {
            return [];
        }

        return iframe.contentWindow.ccms_editors;
    }

    function getFrameDocument() {
        const iframe = document.getElementById("ccmsContFrame");
        if (!iframe || !iframe.contentWindow || !iframe.contentWindow.document) {
            return null;
        }

        return iframe.contentWindow.document;
    }

    function getPersistedImageWidgetHtml(element) {
        if (!element) {
            return "";
        }

        const clone = element.cloneNode(true);
        clone.querySelectorAll('.ccms-img-toolbar, .ccms-upload-progress, .filepond--root, input[type="file"]').forEach(node => node.remove());
        return clone.innerHTML;
    }

    async function saveAllEditorRegions() {
        const editors = getFrameEditors();
        const savedRegionIds = new Set();

        for (const ed of editors) {
            if (!ed || typeof ed.getData !== 'function' || !ed.sourceElement) {
                continue;
            }

            const editorId = ed.sourceElement.getAttribute("data-ccms-ceid");
            if (!editorId) {
                continue;
            }

            await saveEditorRegion(ed.getData(), editorId);
            savedRegionIds.add(editorId);
        }

        return savedRegionIds;
    }

    async function saveAllImageWidgetRegions(savedRegionIds) {
        const doc = getFrameDocument();
        if (!doc) {
            return;
        }

        const imageWidgets = doc.querySelectorAll('[data-editor-config="image-widget"][data-ccms-ceid]');
        for (const widget of imageWidgets) {
            const widgetId = widget.getAttribute('data-ccms-ceid');
            if (!widgetId || savedRegionIds.has(widgetId)) {
                continue;
            }

            const html = getPersistedImageWidgetHtml(widget);
            await saveEditorRegion(html, widgetId);
            savedRegionIds.add(widgetId);
        }
    }

    async function saveChanges(html, editorId) {
        if (editorId) {
            await saveEditorRegion(html || "", editorId);
            return;
        }

        const savedRegionIds = await saveAllEditorRegions();
        await saveAllImageWidgetRegions(savedRegionIds);
        await savePagePropertiesCommand();
    }

    function bgEditClickCustom(command) {
        switch (command) {
            case "Close":
                next = function () {
                    window.location.href = "@Url.Action("Versions", "Editor")/@Model.ArticleNumber";
                }
                $("#divSaveFirstDialog").html("Save page before closing editor?");
                modalCheckSaveFirst.show();
                break;
            case "Preview":
                $("#iframePreview").prop("src", "@Url.Action("Preview", "Home")?articleNumber=" + @Model.ArticleNumber);
                modalPreview.show();
                modalPreview.handleUpdate();
                break;
        }
    }

    function setupFrame() {
        const iframe = document.getElementById("ccmsContFrame");
        const iframeWin = iframe.contentWindow || iframe.contentDocument.parentWindow;
        if (iframeWin.document.body) {
            iframe.height = window.innerHeight - document.getElementById("ccmsNavMenu").clientHeight;
            const contents = $("#ccmsContFrame").contents();
            const anchors = contents.find("a");
            $(anchors).click(function (e) {
                e.preventDefault();
                linksToast.show();
            });
        }

        // ccms_editibleAreas = getEditableAreas(); // Currently set but not consumed.

        // Close loading spinner and display saved status
        $("#divTitleGroup").show();
        $("#spinLoading").hide();
        $("#btnSavingStatus").show();
    }

    function restoreBackup() {
        const model = pendingBackupModel || getRecoverableBackupModel();
        if (model === null) {
            deleteBackup();
            return;
        }

        if ($("#Id").val() == model.Id && typeof model.EditorId !== "undefined" && model.EditorId !== null && model.EditorId !== "") {
            const ckeditor = findEditor(model.EditorId);
            if (ckeditor) {
                const data = isEncryptedPayload(model.Payload) ? decryptData(model.Payload) : (model.Payload || "");
                ckeditor.setData(data);
            }
        }

        deleteBackup();
    }

    function isEncryptedPayload(value) {
        if (typeof value !== "string" || value.trim() === "") {
            return false;
        }

        try {
            const parsed = JSON.parse(value);
            return parsed && typeof parsed === "object" && parsed.v !== undefined && parsed.iv !== undefined && parsed.ct !== undefined;
        } catch {
            return false;
        }
    }

    function getBackupStorageKey() {
        return "ccms_article_" + $("#ArticleNumber").val();
    }

    function getBackupAgeMs(model) {
        if (!model || !model.BackupSavedUtc) {
            return null;
        }

        const savedAt = new Date(model.BackupSavedUtc);
        if (Number.isNaN(savedAt.getTime())) {
            return null;
        }

        return Date.now() - savedAt.getTime();
    }

    function isBackupExpired(model) {
        const ageMs = getBackupAgeMs(model);
        if (ageMs === null) {
            // Legacy backup without timestamp: keep recoverable.
            return false;
        }

        return ageMs > backupMaxAgeMs;
    }

    function isBackupForCurrentEditor(model) {
        if (!model) {
            return false;
        }

        if ($("#Id").val() != model.Id) {
            return false;
        }

        if ($("#ArticleNumber").val() != model.ArticleNumber) {
            return false;
        }

        if (typeof model.EditorId === "undefined" || model.EditorId === null || model.EditorId === "") {
            return false;
        }

        if (model.UserId && model.UserId !== ccms_editor_userid) {
            return false;
        }

        return true;
    }

    function getRecoverableBackupModel() {
        const storageItem = localStorage.getItem(getBackupStorageKey());
        if (typeof storageItem === "undefined" || storageItem === null) {
            return null;
        }

        let model;
        try {
            model = JSON.parse(storageItem);
        } catch {
            deleteBackup();
            return null;
        }

        if (!isBackupForCurrentEditor(model)) {
            return null;
        }

        if (isBackupExpired(model)) {
            deleteBackup();
            return null;
        }

        return model;
    }

    function formatDurationText(ms) {
        if (ms === null || ms < 0) {
            return "recently";
        }

        const minutes = Math.floor(ms / 60000);
        if (minutes < 1) {
            return "just now";
        }

        if (minutes < 60) {
            return `${minutes} minute${minutes === 1 ? "" : "s"} ago`;
        }

        const hours = Math.floor(minutes / 60);
        return `${hours} hour${hours === 1 ? "" : "s"} ago`;
    }

    function configureRecoverModal(model) {
        const modalBody = document.querySelector("#modalRecoverData .modal-body");
        if (!modalBody) {
            return;
        }

        const details = [];
        const ageMs = getBackupAgeMs(model);
        details.push(`Local backup was saved ${formatDurationText(ageMs)}.`);

        const currentVersion = $("#VersionNumber").val();
        if (model.VersionNumber && currentVersion && model.VersionNumber !== currentVersion) {
            details.push(`Backup version (${model.VersionNumber}) differs from current version (${currentVersion}).`);
        }

        const currentUpdated = $("#Updated").val();
        if (model.Updated && currentUpdated && model.Updated !== currentUpdated) {
            details.push("Current page has a different last-updated timestamp.");
        }

        modalBody.innerHTML = `
            <p>A recent save for this page did not succeed, but the changes were saved locally.</p>
            <p>Do you want to recover saved changes?</p>
            <p class="small text-warning mb-0">${details.join(" ")}</p>
        `;
    }

    function deleteBackup() {
        localStorage.removeItem(getBackupStorageKey());
        pendingBackupModel = null;
    }

    $(document).ready(function (e) {
        EditorSaveService.ensureEncryptionContext();

        if (window.ckeditorCopilotChat && typeof window.ckeditorCopilotChat.initialize === 'function') {
            window.ckeditorCopilotChat.initialize();
        }

        // Check for unsaved data
        const backupModel = getRecoverableBackupModel();
        if (backupModel !== null) {
            pendingBackupModel = backupModel;
            configureRecoverModal(backupModel);
            modalRecoverData.show();
        }

        $("#btnOtherPages").show();
        $("#modalChgTitleHeader").html("Change page URL: ");
        $("#newTitle").html("New page URL: ");

        if ($("#UrlPath").val() != "root") {
            $("#divUrlTitleExamples").show();
        }

        $("#btnCcmsCodeEditor").show();
        $("#btnCcmsGrapesJsEditor").show();
        $("#liBtnVersions").show();
        $("#btnVersions").attr("href", "/Editor/Versions/" + $("#ArticleNumber").val() + "?versionNumber=" + $("#VersionNumber").val());
        $("#spanWorkingVersionNo").html("Working Version: " + $("#VersionNumber").val());

        $("#btnApply").click(function (e) {
            var data = editor.getValue();
            ckeditor.data.set(data);
            savePagePropertiesCommand();
        });

        $("#btnSave").click(function () {
            if (isAuthor) {
                $("#btnSaveAndPublish").hide();
                if ($('#Published').val() === "") {
                    $("#btnSaveChanges").show();
                } else {
                    $("#btnSaveAsDraft").show();
                    $("#btnSaveAndPublish").hide();
                    $("#btnSaveChanges").hide();
                }
            } else {
                $("#btnSaveAsDraft").show();
                $("#btnSaveChanges").show();
                if ($('#Published').val() === "") {
                    $("#btnSaveAndPublish").show();
                }
            }
        });

        $("#ccmsContFrame").click(function () {
            $("#btnSave").removeClass("show");
        });

        if (hasModel && isReviewer === false && isAuthor === false && requiresAuthentication) {
            $(".perm").show();
        }
    });

    function getEditableAreas() {
        const iframe = document.getElementById("ccmsContFrame");
        let areas = [];
        const editors = iframe.contentWindow.ccms_editors;
        $(editors).each(function (index, editor) {
            const sourceElement = editor.sourceElement;
            const id = sourceElement.getAttribute("data-ccms-ceid");
            const item = { Id: id, Html: editor.getData() };
            areas.push(item);
        });
        return areas;
    }

    function findEditor(editorId) {
        var iframe = document.getElementById("ccmsContFrame");
        var editors = iframe.contentWindow.ccms_editors;
        var editor;
        $(editors).each(function (index, ed) {
            const sourceElement = ed.sourceElement;
            const id = sourceElement.getAttribute("data-ccms-ceid");
            if (editorId === id) {
                editor = ed;
            }
        });
        return editor;
    }

    /*
    function handle_error(xhr, status, error) {
        EditorUI.doneSaving();
        EditorUI.showError(xhr.responseText);
    }
    */

    $(window).bind('keydown', function (event) {
        if (event.ctrlKey || event.metaKey) {
            switch (String.fromCharCode(event.which).toLowerCase()) {
                case 's':
                    event.preventDefault();
                    const ccms_editibleAreas = iframe.contentWindow.ccms_editibleAreas;
                    if (typeof (ccms_editibleAreas) !== "undefined" && ccms_editibleAreas.length > 0) {
                        savePagePropertiesCommand();
                    }
                    break;
            }
        }
    });

    window.addEventListener('pagehide', function() {
        const iframe = document.getElementById("ccmsContFrame");
        iframe.contentWindow.blurEditors();
    });

    window.addEventListener('resize', function (event) { setupFrame(); }, true);

    function openPickPageModal(ed) {
        ckeditor = ed;
        if (typeof ckeditor === "undefined" || ckeditor === null) {
            alert("Error: Could not open Visual Editor.");
            return;
        }
        $("#combobox").val("");
        $("#inputLinkText").val("");
        $("#switchNewWindow").prop('checked', false);
        $("#inputLinkCss").val("");
        $("#inputLinkStyle").val("");
        pickPageModal.show();
    }

    function openInsertFileLinkModel(ed) {
        ckeditor = ed;
        autoSaveOn = false;
        if (typeof ckeditor === "undefined" || ckeditor === null) {
            alert("Error: Could not open Visual Editor.");
            return;
        }
        openSelectFileModal("file");
    }

    function openInsertImageModel(ed) {
        ckeditor = ed;
        autoSaveOn = false;
        if (typeof ckeditor === "undefined" || ckeditor === null) {
            alert("Error: Could not open Visual Editor.");
            return;
        }
        openSelectFileModal("image");
    }

    function insertImage(path) {
        if (typeof path === "undefined" || path === null || path === "") {
            return;
        }
        ckeditor.model.change(writer => {
            autoSaveOn = false;
            const url = fileBaseUrl + "/" + path;
            const viewFragment = ckeditor.data.processor.toView("<img src='" + url + "' />");
            const anchor = ckeditor.data.toModel(viewFragment);
            ckeditor.model.insertContent(anchor);
            clearFileMgrPaths();
            autoSaveOn = true;
        });
        next = null;
    }

    function insertPageLink() {
        if (typeof ckeditor === "undefined" || ckeditor === null) {
            alert("Error: Could not open Visual Editor.");
            return;
        }
        const inputLinkText = $("#inputLinkText").val();
        if (typeof (inputLinkText) === "undefined" || inputLinkText === null || inputLinkText === "") {
            $("#inputLinkTextError").show();
            return false;
        }
        pickPageModal.hide();
        ckeditor.model.change(writer => {
            const viewFragment = ckeditor.data.processor.toView("<a href='/" + selectedAnchorData.url + "'>" + inputLinkText + "</a>");
            const anchor = ckeditor.data.toModel(viewFragment);
            ckeditor.model.insertContent(anchor);
            ckeditor.editing.view.focus();
        });
    }

    function insertFileLink(path) {
        if (typeof path === "undefined" || path === null || path === "") {
            next = null;
            return;
        }
        autoSaveOn = false;
        ckeditor.model.change(writer => {
            const url = fileBaseUrl + "/" + path;
            const viewFragment = ckeditor.data.processor.toView("<a href='" + url + "'>" + path + "</a>");
            const anchor = ckeditor.data.toModel(viewFragment);
            ckeditor.model.insertContent(anchor);
            ckeditor.editing.view.focus();
            clearFileMgrPaths();
            autoSaveOn = true;
        });
        next = null;
    }

    function ccms_setBannerImage(url) {
        const value = $("#BannerImage").val();
        if (value === null || value === "") {
            $("#BannerImage").val(url);
        }
        checkBannerImage();
    }

    function addCkeditorSession(id, email) {
        let iframe = document.getElementById("ccmsContFrame");
        let editors = iframe.contentWindow.ccms_editors;
        $(editors).each(function (index, ed) {
            const sourceElement = ed.sourceElement;
            const editorId = sourceElement.getAttribute("data-ccms-ceid");
            if (editorId === id) {
                ed.enableReadOnlyMode(email);
                $(sourceElement).css("border-color", "red");
            }
        });
        $(iframe.contentWindow.__cwps__toolTips).each(function (index, tip) {
            const tipId = tip.reference.getAttribute("data-ccms-ceid");
            if (tipId === id) {
                tip.setProps({ theme: "material" });
                tip.setContent(email);
                tip.show();
            }
        });
    }

    function removeCkeditorSession(id, email) {
        // lockedEditors = lockedEditors.filter(item => item !== id); // Currently write-only in current flow.
        let iframe = document.getElementById("ccmsContFrame");
        let editors = iframe.contentWindow.ccms_editors;
        $(editors).each(function (index, ed) {
            const sourceElement = ed.sourceElement;
            const editorId = sourceElement.getAttribute("data-ccms-ceid");
            if (editorId === id) {
                ed.disableReadOnlyMode(email);
                $(sourceElement).css("border-color", "#dadada");
            }
        });
        $(iframe.contentWindow.__cwps__toolTips).each(function (index, tip) {
            const tipId = tip.reference.getAttribute("data-ccms-ceid");
            if (tipId === id) {
                tip.setProps({ theme: "" });
                tip.setContent("Editable.");
                tip.hide();
            }
        });
    }

    // Used by dublicator.js
    async function savePageBody(html) {
        EditorUI.saving();
        await EditorSaveService.ensureEncryptionContext();

        const model = {
            ArticleNumber: $("#ArticleNumber").val(),
            EditorId: "body",
            Command: "SaveBody",
            Payload: html
        };

        try {
            const response = await EditorSaveService.saveArticle(model, "SaveBody");
            EditorSaveService.handleSaveResponse(response, {
                updateUI: true,
                onSuccess: () => EditorUI.doneSaving(),
                onError: (msg) => EditorUI.showError(msg)
            });
        } catch (error) {
            EditorUI.showError(error.message);
            EditorUI.doneSaving();
        }
    }

