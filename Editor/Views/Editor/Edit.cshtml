    async function savePagePropertiesCommand(html, editorId) {
        EditorUI.saving();

        savePublishDateTime();
        await EditorSaveService.ensureEncryptionContext();

        const model = {
            Id: $("#Id").val(),
            ArticleNumber: $("#ArticleNumber").val(),
            BannerImage: $("#BannerImage").val(),
            EditorId: editorId,
            UserId: ccms_editor_userid,
            Published: $("#Published").val(),
            Updated: $("#Updated").val(),
            Title: $("#Title").val(),
            VersionNumber: $("#VersionNumber").val(),
            BackupSavedUtc: new Date().toISOString(),
            Command: "SavePageProperties",
            Payload: html || ""
        };

        localStorage.setItem(getBackupStorageKey(), JSON.stringify(model));

        try {
            const response = await EditorSaveService.saveArticle(model, "SavePageProperties");
            
            if (EditorSaveService.handleSaveResponse(response, {
                updateUI: true,
                onSuccess: () => {
                    deleteBackup();
                    EditorUI.doneSaving();
                    if (next !== null && typeof next === 'function') {
                        next();
                        next = null;
                    }
                },
                onError: (msg) => {
                    EditorUI.showError(msg);
                    EditorUI.doneSaving();
                }
            })) {
                // Success
            }
        } catch (error) {
            EditorUI.showError("Save failed: " + error.message);
            EditorUI.doneSaving();
        }
    }

    function cosmosSignalUpdateEditor(data) {
        let iframe = document.getElementById("ccmsContFrame");
        let editors = iframe.contentWindow.ccms_editors;
        $(editors).each(function (index, editor) {
            const editorId = editor.sourceElement.getAttribute("data-ccms-ceid");
            if (editorId === data.EditorId) {
                editor.setData(data.Payload);
            }
        });
    }

</script>
