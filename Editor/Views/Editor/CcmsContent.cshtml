@using Cosmos.Cms.Common
@using Microsoft.AspNetCore.Components
@model Cosmos.Common.Models.ArticleViewModel
@{
    Layout = null;
    ViewData["Title"] = Model.Title;
    var data = new ImportMapDefinition(
        new Dictionary<string, string>()
                                {
            { "ckeditor5", "/lib/ckeditor/ckeditor5.js" },
            { "ckeditor5/", "/lib/ckeditor/" },

            { "skycmsplugins", "/lib/cosmos/ckeditor/skycms-plugins.js" },
                                },
        null,
        null);
}
<!DOCTYPE HTML>
<html lang="@Model.LanguageCode">
<head>
    <title>@Model.Title</title>
    <meta name="cwps-meta-path-title" content="@Model.Title" />
    <meta name="cwps-meta-path-url" content="@Model.UrlPath" />
    <meta name="cwps-meta-path-updated" content="@Model.Updated" />
    @if (Model.ArticleType == ArticleType.BlogStream || Model.ArticleType == ArticleType.BlogPost)
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@picocss/pico@2.1.1/css/pico.conditional.min.css" integrity="sha384-QfeWAE0GpftbPGpYsRxM9hV8glCwhQEin0VM1Nb3eiisL9ayUJiRyy2Db6kANFsn" crossorigin="anonymous">
    }
    <style>
        figure.media {
            width: 640px;
        }

        .ck.ck-block-toolbar-button {
            transform: translateX( 30px ) translateY( -80px ) !important;
            background-color: white !important;
            border: 3px solid blue !important;
        }

        div.img-block:hover {
            border: 1px solid blue !important; /* Change border on hover */
        }

    </style>
    @Html.Raw(Model.Layout.Head)
    <link asp-append-version="true" rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/44.1.0/ckeditor5.css" />
    <link href="https://cdn.jsdelivr.net/npm/filepond@4.32.6/dist/filepond.min.css" rel="stylesheet" integrity="sha384-TclCA2vTcjELuMbsLCt9deOlUllk1dZV0XmFcwlYit0UgFaqL7EVKvGOgdfzRg3M" crossorigin="anonymous" />
    @Html.Raw(Model.HeadJavaScript)
    <script asp-append-version="true" src="~/lib/cosmos/image-widget/image-widget.js"></script>
    <script asp-append-version="true" src="~/lib/cosmos/dublicator/componets/components.js"></script>
    <script asp-append-version="true" src="~/lib/cosmos/dublicator/dublicator.js"></script>
</head>
<body>
    @Html.Raw(Model.Layout.HtmlHeader)
    @if (Model.ArticleType == Cosmos.Cms.Common.ArticleType.BlogPost)
    {
        <partial name="_BlogPostEditPartial" model="Model" />
    }
    else
    {
        <div ccms-content-id="@Model.Id">
            @Html.Raw(Model.Content)
        </div>
    }
    @Html.Raw(Model.Layout.FooterHtmlContent)
    @Html.Raw(Model.FooterJavaScript)
    @Html.AntiForgeryToken()
    <script type="importmap" asp-importmap="@data">
    </script>
    @* <link href="https://cdn.jsdelivr.net/npm/cropperjs@2.0.1/dist/cropper.min.css" rel="stylesheet" /> *@
    <script src="https://cdn.jsdelivr.net/npm/cropperjs@2.0.1/dist/cropper.min.js" integrity="sha384-+4jB6ZLK6KT1AEmG+YM6qdVRVFhSjOTTQXKg/dfzjZ1c+vOtguwSHNO4nFhQWnI8" crossorigin="anonymous"></script>
    <script>

        // Create editors
        var ccms_editors = [];
        var ccms_editorIds = [];
        var focusedEditor;
        // var unmoutCkBox; // Currently unused.
        var articleNumber = @Model.ArticleNumber;
        // var articleId = "@Model.Id"; // Currently unused.

        // let autosaveTimeout = null; // Currently unused.

        // Autosave control flag (accessible from iframe CKEditor)
        window.enableAutoSave = true;

        // Save functions for CKEditor autosave support
        // Note: These are stubs that delegate to parent window when in Edit.cshtml iframe context
        window.savePagePropertiesCommand = async function(html, editorId) {
            // If we're in an iframe and parent has the consolidated save entry point, delegate to it
            if (window.parent && window.parent !== window && typeof window.parent.savePagePropertiesCommand === 'function') {
                return window.parent.savePagePropertiesCommand(html, editorId);
            }
            // Otherwise, this is standalone CcmsContent view - just resolve
            console.log('CcmsContent savePagePropertiesCommand called (standalone mode):', editorId);
            return Promise.resolve();
        };

        window.saveChanges = async function(html, editorId) {
            if (window.parent && window.parent !== window) {
                if (typeof window.parent.saveChanges === 'function') {
                    return window.parent.saveChanges(html, editorId);
                }

                if (editorId && typeof window.parent.saveEditorRegion === 'function') {
                    return window.parent.saveEditorRegion(html, editorId);
                }

                if (typeof window.parent.savePagePropertiesCommand === 'function') {
                    return window.parent.savePagePropertiesCommand(html, editorId);
                }
            }

            console.log('CcmsContent saveChanges called (standalone mode):', editorId);
            return Promise.resolve();
        };

        window.saveEditorRegion = async function(html, editorId) {
            // If we're in an iframe and parent has saveEditorRegion, delegate to it
            if (window.parent && window.parent !== window && typeof window.parent.saveEditorRegion === 'function') {
                return window.parent.saveEditorRegion(html, editorId);
            }
            // Otherwise, this is standalone CcmsContent view - just resolve
            console.log('CcmsContent saveEditorRegion called (standalone mode):', editorId);
            return Promise.resolve();
        };

        function ccms___beforeDomMutation(target) {
            const mutationRoot = target || document.querySelector('div[ccms-content-id]') || document.body;
            
            // Destroy FilePond instances
            if (typeof window.ccms___destroyPondsInElement === 'function') {
                window.ccms___destroyPondsInElement(mutationRoot);
            }
            
            // Destroy CKEditor instances before DOM mutation to prevent stale references
            if (typeof window.ccms___destroyAllEditors === 'function') {
                window.ccms___destroyAllEditors().catch(error => {
                    console.warn('Error during editor destruction before DOM mutation:', error);
                });
            }
        }

        window.ccms___beforeDomMutation = ccms___beforeDomMutation;

        // Blur editors
        window.addEventListener('blur', function() {
            blurEditors();
        });

        // Blur editors
        function blurEditors() {
            // Make sure UI is closed for last editor that was active.
            const focused = document.querySelector('.ck-focused');
            if (focused) {
                focused.classList.remove('ck-focused');
            }
            const element = document.querySelector('.ck-balloon-panel_visible');
            if (element) {
                element.classList.remove('ck-balloon-panel_visible');
            }
        }

        // Close all dropdowns
        window.addEventListener("click", function () {
            if (window.parent && window.parent !== window && typeof window.parent.closeDropDowns === 'function') {
                window.parent.closeDropDowns();
            }
        });

        window.addEventListener("keydown", (event) => {
            if (event.isComposing || event.keyCode === 229) {
                return;
            }

            // Handle CTRL-S to save changes
            if (event.ctrlKey || event.metaKey) {
                switch (String.fromCharCode(event.which).toLowerCase()) {
                    case 's':
                        event.preventDefault();

                        const activeEditor = focusedEditor || (ccms_editors.length === 1 ? ccms_editors[0] : null);
                        if (activeEditor && typeof activeEditor.getData === 'function' && activeEditor.sourceElement) {
                            const editorId = activeEditor.sourceElement.getAttribute("data-ccms-ceid");
                            window.saveChanges(activeEditor.getData(), editorId);
                        } else {
                            window.saveChanges();
                        }
                        break;
                }
            }
        });

    </script>

    <script asp-append-version="true" src="~/lib/popper/umd/popper.min.js"></script>
    <script asp-append-version="true" src="~/lib/tippy/tippy.umd.min.js"></script>
    <script asp-append-version="true" type="module" src="~/lib/cosmos/ckeditor/ckeditor-widget.301.js"></script>

    <script>
        const elements = document.querySelectorAll('[data-ccms-ceid]');
        elements.forEach(function (el, index) {
            el.setAttribute("data-tippy-content", "Editable.")
        });

        // NodeList
        let __cwps__toolTips = tippy(elements, {
            placement: "right-start",
            inlinePositioning: true,
        }); //data-ccms-ceid
        
        document.addEventListener('DOMContentLoaded', function () {
            const wineItems = document.querySelectorAll('.ccms-clone');
            wineItems.forEach(function (element) {
                Duplicator.create(element)
            });
        });
    </script>
    @* FilePond and Image Widget *@
    <script asp-append-version="true" src="~/lib/filepond-plugin-file-metadata/dist/filepond-plugin-file-metadata.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/filepond@4.32.6/dist/filepond.min.js" integrity="sha384-Eeqgmq0luVn6HThRQfVchBi+0ROgVXYcUDAsJHU+YDa7yUykpjzyq0R9iDB3ueal" crossorigin="anonymous"></script>
</body>
</html>
