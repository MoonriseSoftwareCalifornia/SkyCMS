@using Sky.Editor.Data.Logic
@using Sky.Editor.Services.EditorSettings
@inject IEditorSettings options
@{
    ViewData["Title"] = "Web Page Inventory";

    var isReviewer = User.IsInRole("Reviewers");
    var canEdit = User.IsInRole("Administrators") || User.IsInRole("Editors");

    var homeArticleNumber = (int)ViewData["HomePageArticleNumber"];
    var showFirstPageBtn = (bool)ViewData["ShowFirstPageBtn"];
    var showNotFoundBtn = (bool)ViewData["ShowNotFoundBtn"];

}
<link href="~/lib/tabulator-tables/dist/css/tabulator_midnight.css" rel="stylesheet" />
<script src="~/lib/luxon/luxon.min.js"></script>
<script src="~/lib/tabulator-tables/dist/js/tabulator.min.js"></script>
<script src="~/js/clipboard.min.js"></script>
<script src="~/lib/cosmos/editDropDownBuilder.js"></script>
<style>
    .fs-small {
        font-size: 0.8em;
    }

    /* Keep Tabulator rows from clipping Bootstrap dropdowns in action cells. */
    #pagelist-table .tabulator-row,
    #pagelist-table .tabulator-cell {
        overflow: visible;
    }

    /* Ensure dropdown menu stacks above table content. */
    #pagelist-table .dropdown-menu {
        z-index: 3000;
    }

    /* Raise the actions cell/dropdown stacking context above neighboring rows. */
    #pagelist-table .btn-group,
    #pagelist-table .dropdown {
        position: relative;
        z-index: 2000;
    }

    /* Only the row with an open dropdown should float above sibling rows. */
    #pagelist-table .tabulator-row.dropdown-open {
        position: relative;
        z-index: 2500;
    }
</style>

<div class="pt-3">
    @Html.AntiForgeryToken()
    <div class="container">
        <div class="row">
            <div class="col">
                <h3 class="text-light">@ViewData["Title"]</h3>
                @if (showFirstPageBtn)
                {
                    <p><a class="text-light" title="Recommendation: Create website home page" href="/Editor/Create">Recommendation: Create Home Page <i class="fa-solid fa-circle-arrow-right"></i></a></p>
                }
                @if (showFirstPageBtn == false && showNotFoundBtn)
                {
                    <p><a class="text-light" title="Recommendation: Create a custom 'not found' page." href="/Editor/Create?title=Not%20Found">Recommendation: Create a custom 'not found' page <i class="fa-solid fa-circle-arrow-right"></i></a></p>
                }
            </div>
        </div>
        <div class="row cpws-table-pager-row-top">
            <div class="col-md-6">
                @if (!isReviewer)
                {
                    <div class="btn-group" role="group" aria-label="Actions">
                        <a asp-action="Versions" asp-route-id="@homeArticleNumber" title="Edit home page" class="btn btn-sm btn-success">Edit home page</a>
                        <a class="btn btn-sm btn-primary" title="Create a new web page" asp-action="Create">New Page</a>
                        <a class="btn btn-sm btn-secondary" title="Create a new web page" asp-action="Index" asp-controller="Templates">Templates</a>
                        <a title="Manage redirects" class="btn btn-sm btn-secondary" asp-action="Redirects">Redirects</a>
                        <a title="Manage layouts" class="btn btn-sm btn-secondary" asp-action="Index" asp-controller="Layouts">Layouts (formerly Site Design)</a>
                        <a title="Manage reserved paths" class="btn btn-sm btn-secondary" asp-action="ReservedPaths" asp-controller="Editor">Reserved Paths</a>
                        <a title="Manage trash" class="btn btn-sm btn-secondary" asp-action="Trash">Trash</a>
                    </div>
                }
            </div>
            <div class="col-md-6 d-flex justify-content-end">
            </div>
        </div>

        <div class="row bg-dark">
            <div class="col-md-12">
                <div id="pagelist-table" class="table-dark"></div>
            </div>
        </div>

        <div class="row cpws-table-pager-row-bottom">
            <div class="col-md-12 d-flex justify-content-center">
                &nbsp;
            </div>
        </div>
    </div>
</div>

<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3"></div>

<script>

    const publisherUrl = "@options.PublisherUrl.TrimEnd('/')";
    const tblHeight = window.innerHeight - 200;
    const inventoryRowTypes = {
        page: "page",
        blog: "blog",
        blogPost: "blogPost"
    };
    let pageSize = Math.round(tblHeight / 50) + 1;

    function dateTime(cell, formatterParams, onRendered){
        //cell - the cell component
        //formatterParams - parameters set for the column
        //onRendered - function to call when the formatter has been rendered
        return getLocalTime(cell.getValue());
    }

    function dateFilterFunction(headerValue, rowValue, rowData, filterParams){
        if (rowValue === null || rowValue === "") {
            return false;
        }
        return headerValue === rowValue.split("T")[0]; //must return a boolean, true if it passes the filter.
    }

    async function sendToTrash(articleNumber) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const result = await fetch("@Url.Action("TrashArticle", "Editor")/" + articleNumber, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token ?? ''
            }
        });
        if (result.ok) {
            pageTable.setData();
        }
    }

    function openArticleVersions(e, cell) {
        const data = cell.getRow().getData();
        window.location.href = "@Url.Action("Versions")/" + data.ArticleNumber;
    }

    function openInventoryItem(e, cell) {
        const data = cell.getRow().getData();
        if (data.RowType === inventoryRowTypes.blog && data.BlogKey) {
            window.location.href = "/editor/blogs/" + encodeURIComponent(data.BlogKey) + "/posts";
            return;
        }

        openArticleVersions(e, cell);
    }

    function unpublish(articleNumber) {
        const data = cell.getRow().getData();
        $.get("@Url.Action("UnpublishPage", "Editor")/" + articleNumber, function (data) {
            pageTable.setData();
        });
    }

    const trashBtn = function(cell, formatterParams){
        const data = cell.getRow().getData();
        if (data.IsDefault === true){
            return "";
        }

        let itemLabel = "page";
        if (data.RowType === inventoryRowTypes.blog) {
            itemLabel = "blog";
        } else if (data.RowType === inventoryRowTypes.blogPost) {
            itemLabel = "post";
        }

        return "<button type='button' title='Send " + itemLabel + " to trash' onclick='sendToTrash(" + data.ArticleNumber + ", \"" + data.Title + "\")' class='btn btn-sm btn-secondary'><i class='fa-solid fa-trash'></i></button>";
    };

    function getPreviewPath(data) {
        const rawPath = data.PreviewUrlPath || data.UrlPath || "";
        return rawPath === "root" ? "" : rawPath;
    }

    function buildPreviewButton(data, label, title) {
        const previewPath = getPreviewPath(data);
        if (data.LastPublished !== null && data.LastPublished !== "") {
            return "<a target='_blank' href='" + publisherUrl + "/" + previewPath + "' title='" + title + "' class='btn btn-sm btn-secondary'><i class='fa-solid fa-arrow-up-right-from-square'></i> " + label + "</a>";
        }

        return "<a title='Cannot open item on website until it is published.' onclick='alert(\"Cannot open item on website until it is published.\")' class='btn btn-sm btn-secondary'><i class='fa-solid fa-arrow-up-right-from-square'></i></a>";
    }

    function buildBlogPostsButton(blogKey, label, title) {
        if (!blogKey) {
            return "";
        }

        return "<a href='/editor/blogs/" + encodeURIComponent(blogKey) + "/posts' title='" + title + "' class='btn btn-sm btn-secondary'><i class='fa-solid fa-newspaper'></i> " + label + "</a>";
    }

    function titleFormatter(cell, formatterParams, onRendered) {
        const data = cell.getRow().getData();
        const title = data.Title || "";
        if (data.RowType === inventoryRowTypes.blog) {
            return "<span class='badge text-bg-info me-2'>Blog</span>" + title;
        }

        if (data.RowType === inventoryRowTypes.blogPost) {
            return "<span class='badge text-bg-secondary me-2'>Post</span>" + title;
        }

        return title;
    }

    function buildEditorDropDownMarkup(articleNumber, usesPageEditor) {
        if (typeof ccms___buildEditDropDownMenu !== "function") {
            let fallback = "<a class='btn btn-sm btn-secondary' title='Drag-and-drop page layout builder' href='/Editor/PageBuilder/" + articleNumber + "'><i class='fa-solid fa-table-columns me-2'></i> Page Builder</a>";
            fallback += "<a class='btn btn-sm btn-secondary' title='Edit HTML and template markup' href='/Editor/EditCode/" + articleNumber + "'><i class='fa-solid fa-code me-2'></i> Code Editor</a>";
            if (usesPageEditor) {
                fallback += "<a class='btn btn-sm btn-secondary' title='Visual editor for rich content' href='/Editor/VisualEditor/" + articleNumber + "'><i class='fa-solid fa-pen-to-square me-2'></i> Visual Editor</a>";
            }

            return fallback;
        }

        const dropdown = ccms___buildEditDropDownMenu(articleNumber, usesPageEditor, "Edit");
        dropdown.classList.add("btn-group", "btn-group-sm");

        const button = dropdown.querySelector("button");
        if (button) {
            button.classList.add("btn-sm");
            button.title = "Choose an editor";
        }

        const dropdownMenu = dropdown.querySelector(".dropdown-menu");
        if (dropdownMenu) {
            dropdownMenu.classList.add("dropdown-menu-dark");
        }

        return dropdown.outerHTML;
    }

    const menuBar = function(cell, formatterParams){
        const data = cell.getRow().getData();

        let html = "<div class='btn-group btn-group-sm' role='group' aria-label='Inventory actions.'>";

        html += buildEditorDropDownMarkup(data.ArticleNumber, data.UsesHtmlEditor === true);

        if (data.RowType === inventoryRowTypes.blog || data.RowType === inventoryRowTypes.blogPost) {
            html += buildBlogPostsButton(data.BlogKey, "Posts", "Open blog posts list.");
        }

        html += buildPreviewButton(data, "Preview", "Open item on website.");

        if (data.RowType === inventoryRowTypes.page && data.IsDefault === true){
            html += "<div title='Current home page.' class='btn btn-sm btn-primary'><i class='fa-solid fa-house'></i></div>";
        }
        else if (data.RowType === inventoryRowTypes.page && data.LastPublished !== null && data.LastPublished !== ""){
            html += "<a href='/Editor/NewHome/" + data.ArticleNumber + "' title='Make this the new home page.' class='btn btn-sm btn-secondary'><i class='fa-solid fa-house'></i></a>";
        }
        else if (data.RowType === inventoryRowTypes.page)
        {
            html += "<a title='Cannot make this the new home page until it is published.' onclick='alert(\"Cannot make this the home until it is published.\")' class='btn btn-sm btn-secondary'><i class='fa-solid fa-house'></i></a>";
        }

        html += "<a class='btn btn-sm btn-secondary' title='Create a clone of this page' href='/Editor/Clone/" + data.ArticleNumber + "'><i class='fa-solid fa-copy'></i></a>";

        if (data.LastPublished !== null && canEdit && data.IsDefault === false)
        {
            html += "<button onclick='unpublish(" + data.ArticleNumber + ")' title='Unpublishes a this item, and makes it no longer accessible except for editing.' class='btn btn-sm btn-secondary'><i class='fa-solid fa-calendar-xmark'></i></button>";
        }
        html += "</div>";
        return html;
    };

    const pageTable = new Tabulator("#pagelist-table", {
        height:tblHeight + "px",
        pagination:true, //enable pagination
        paginationMode:"local", //enable local pagination
        paginationSize:pageSize, //optional parameter to request a certain number of rows per page
        dataTree:true,
        dataTreeChildField:"_children",
        dataTreeStartExpanded:false,
        dataTreeSort:true,
        dataTreeFilter:true,
        persistence:{
            sort: true, //persist column sorting
            filter: true, //persist filters
            headerFilter: true, //persist header filters
            group: false, //persist row grouping
            page: true, //persist page
            columns: false, //persist columns
        },
        persistenceWriterFunc:function(id, type, data){
            //id - tables persistence id
            //type - type of data being persisted ("sort", "filter", "group", "page" or "columns")
            //data - array or object of data
            sessionStorage.setItem(id + "-" + type, JSON.stringify(data));
        },
        persistenceReaderFunc:function(id, type){
            //id - tables persistence id
            //type - type of data being persisted ("sort", "filter", "group", "page" or "columns")
            var data = sessionStorage.getItem(id + "-" + type);
            return data ? JSON.parse(data) : false;
        },
        layout:"fitColumns",
        ajaxURL:"@Url.Action("GetArticleList", "Editor")?publishedOnly=false", //ajax URL
        columns:[
            {title:"Type", field:"RowType", visible:false },
            {title:"BlogKey", field:"BlogKey", visible:false },
            {title:"UrlPath", field:"UrlPath", visible: false },
            {title:"PreviewUrlPath", field:"PreviewUrlPath", visible: false },
            {title:"No.", field:"ArticleNumber", visible: false },

            {title:"Actions", field:"IsDefault", formatter:menuBar, width:300, headerSort:false },

            {title:"Published",
                field:"LastPublished",
                headerFilter:"date",
                headerFilterFunc:dateFilterFunction,
                cellClick:openInventoryItem,
                width:180,
                sorter:"datetime",
                sorterParams:{
                    format:"iso" },
                formatter:"datetime",
                formatterParams:{
                    inputFormat:"iso",
                    outputFormat:"MM/dd/yyyy HH:mm:ss",
                    invalidPlaceholder:"(Invalid date)"
                }
            },

            {title:"Updated",
                field:"Updated",
                headerFilter:"date",
                headerFilterFunc:dateFilterFunction,
                cellClick:openInventoryItem,
                width:180,
                sorter:"datetime",
                sorterParams:{
                    format:"iso" },
                formatter:"datetime",
                formatterParams:{
                    inputFormat:"iso",
                    outputFormat:"MM/dd/yyyy HH:mm:ss",
                    invalidPlaceholder:"(Invalid date)"
                }
            },

            {title:"Title", field:"Title", sorter:"string", formatter:titleFormatter, headerFilter:"input", cellClick:openInventoryItem },

            {title: "Trash", field:"ArticleNumber", formatter:trashBtn, width:56, headerSort:false, hozAlign:"center", headerHozAlign:"center" }

        ],
    });

    const canEdit = @canEdit.ToString().ToLower();
    const clipboard = new ClipboardJS('.clipboard');
    clipboard.on('success',
        function (e) {
            console.info('Action:', e.action);
            console.info('Text:', e.text);
            console.info('Trigger:', e.trigger);
            alert("Copied: " + e.text);
            e.clearSelection();
        });

    var articleNumber;
    var articleTitle;

    function selectArticle(articleNo, title) {
        articleNumber = articleNo;
        $("#articleTitle").html("&quot;" + title + "&quot;");
        return true;
    }

    $(document).ready(function () {

        $("body").addClass("cwps-editor-container");

        $(".toLocalTimeZone").each(function (index, element) {
            $(element).html(getLocalTime($(element).html()));
        });

        // Keep the active row above adjacent rows while its dropdown is open.
        document.addEventListener("show.bs.dropdown", function (event) {
            const row = event.target?.closest(".tabulator-row");
            if (row) {
                row.classList.add("dropdown-open");
            }
        });

        document.addEventListener("hide.bs.dropdown", function (event) {
            const row = event.target?.closest(".tabulator-row");
            if (row) {
                row.classList.remove("dropdown-open");
            }
        });

        $("#btnCreate").hide();

        $("#btnCreate").click(function (e) {
            window.location.href = "@Url.Action("Create", "Editor")?title=";
        });

    });


</script>
