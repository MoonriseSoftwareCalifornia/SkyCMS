@{
    Layout = null;
    ViewData["Title"] = "AI Help Chat";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" type="text/css" href="~/lib/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/css/CodeEditor.css" />
    <style>
        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: #111315;
        }

        .ai-help-popup-shell {
            width: 390px;
            max-width: 100%;
            height: 100vh;
            margin: 0 auto;
            padding: 8px;
            box-sizing: border-box;
        }

        .ai-help-chat-panel {
            width: 100%;
            height: 100%;
            min-width: 0;
        }
    </style>
</head>
<body>
    <div class="ai-help-popup-shell">
        <aside id="aiHelpChatPanel" class="copilot-chat-panel ai-help-chat-panel" aria-label="AI help chat panel">
            <div class="copilot-chat-header">
                <div>
                    <div class="copilot-chat-title">AI Help Assistant</div>
                    <div id="aiHelpChatSubtitle" class="copilot-chat-subtitle">Ask about SkyCMS, website development, or this site.</div>
                </div>
                <button id="btnAiHelpClearChat" type="button" class="btn btn-sm btn-outline-light">Clear</button>
            </div>

            <div class="copilot-chat-actions" role="toolbar" aria-label="AI help actions">
                <button type="button" class="btn btn-sm btn-secondary" data-ai-help-action="skycms-help" data-ai-help-mode="general-help">SkyCMS help</button>
                <button type="button" class="btn btn-sm btn-secondary" data-ai-help-action="website-help" data-ai-help-mode="general-help">Website guidance</button>
                <button type="button" class="btn btn-sm btn-secondary" data-ai-help-action="site-help" data-ai-help-mode="site-help">This site</button>
            </div>

            <div class="copilot-model-row px-3 pt-2">
                <label class="form-label form-label-sm mb-0" for="aiHelpModelSelect">Model</label>
                <div class="d-flex gap-2">
                    <select id="aiHelpModelSelect" class="form-select form-select-sm" disabled>
                        <option value="">Default</option>
                    </select>
                    <button id="btnAiHelpRefreshModels" type="button" class="btn btn-sm btn-outline-light">Refresh</button>
                </div>
                <div id="aiHelpModelHelp" class="copilot-model-help"></div>
            </div>

            <div id="aiHelpChatMessages" class="copilot-chat-messages">
                <div class="copilot-chat-empty">AI help chat is loading…</div>
            </div>

            <div id="aiHelpChatStatus" class="copilot-chat-status" style="display:none"></div>

            <form id="aiHelpChatForm" class="copilot-chat-form">
                <label class="visually-hidden" for="aiHelpChatInput">Ask AI for help</label>
                <textarea id="aiHelpChatInput" class="form-control form-control-sm" rows="4" placeholder="Ask a question about SkyCMS, website content, SEO, accessibility, or architecture."></textarea>
                <div class="copilot-chat-footer">
                    <span class="copilot-chat-hint">Enter sends. Shift+Enter adds a new line.</span>
                    <button id="btnAiHelpSend" type="submit" class="btn btn-sm btn-primary">Send</button>
                </div>
            </form>
        </aside>
    </div>

    <script asp-append-version="true" src="~/js/editors/ai-help-chat.js"></script>
</body>
</html>