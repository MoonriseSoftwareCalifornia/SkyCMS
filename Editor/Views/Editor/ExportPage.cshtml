@using Sky.Cms.Services
@using Sky.Editor.Data.Logic
@using Microsoft.Extensions.Options;
@using Cosmos.Cms.Common.Services.Configurations
@using Sky.Cms.Controllers

@model ArticleViewModel
@{
    Layout = "_LayoutPreview";
    ViewData["Title"] = Model.Title;
}

@Html.Raw(PageImportConstants.COSMOSBODYHEADERSTART)
@Html.Raw(Model.Layout.HtmlHeader)
@Html.Raw(PageImportConstants.COSMOSBODYHEADEREND)

@Html.Raw(Model.Content)

@Html.Raw(PageImportConstants.COSMOSBODYFOOTERSTART)
@Html.Raw(Model.Layout.FooterHtmlContent)
@Html.Raw(PageImportConstants.COSMOSBODYFOOTEREND)

@Html.Raw(Model.FooterJavaScript)
