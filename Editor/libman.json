{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "defaultDestination": "wwwroot/lib/",
  "libraries": [
    {
      "library": "@microsoft/signalr@8.0.7",
      "provider": "unpkg",
      "destination": "wwwroot/lib/signalr/"
    },
    {
      "library": "bootstrap@5.3.3",
      "destination": "wwwroot/lib/bootstrap"
    },
    {
      "library": "cropperjs@2.0.1",
      "destination": "wwwroot/lib/cropperjs"
    },
    {
      "library": "filepond@4.32.6",
      "destination": "wwwroot/lib/filepond/"
    },
    {
      "library": "jquery-validate@1.21.0",
      "destination": "wwwroot/lib/jquery-validate"
    },
    {
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "wwwroot/lib/jquery-validation-unobtrusive"
    },
    {
      "library": "luxon@3.5.0",
      "destination": "wwwroot/lib/luxon"
    },
    {
      "library": "monaco-editor@0.53.0",
      "destination": "wwwroot/lib/monaco"
    },
    {
      "library": "node_modules/grapesjs-blocks-basic/dist/",
      "provider": "filesystem",
      "destination": "wwwroot/lib/grapesjs-blocks-basic/"
    },
    {
      "library": "node_modules/grapesjs-plugin-forms/dist/",
      "provider": "filesystem",
      "destination": "wwwroot/lib/grapesjs-plugin-forms/"
    },
    {
      "library": "node_modules/grapesjs/dist/",
      "provider": "filesystem",
      "destination": "wwwroot/lib/grapesjs/"
    },
    {
      "library": "node_modules/grapesjs/dist/css/",
      "provider": "filesystem",
      "destination": "wwwroot/lib/grapesjs/css/"
    },
    {
      "library": "node_modules/grapick/dist/",
      "provider": "filesystem",
      "destination": "wwwroot/lib/grapick/"
    },
    {
      "library": "picocss@2.1.1",
      "destination": "wwwroot/lib/picocss/"
    },
    {
      "library": "popper.js@2.11.8",
      "destination": "wwwroot/lib/popper"
    },
    {
      "library": "tabulator-tables@6.3.1",
      "provider": "unpkg",
      "destination": "wwwroot/lib/tabulator-tables"
    },
    {
      "library": "tippy.js@6.3.7",
      "destination": "wwwroot/lib/tippy/"
    }
  ]
}
