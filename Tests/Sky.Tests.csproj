<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<UserSecretsId>c44b0fbc-a20c-4a15-8e5b-1a9eb09e6ac1</UserSecretsId>
		<Version>9.3.0.1</Version>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Suppress CS0618: Using obsolete SaveArticle method for legacy integration tests -->
		<!-- Suppress MSTEST0006: Keep ExpectedException attributes for now, will migrate later -->
		<NoWarn>$(NoWarn);CS0618;MSTEST0006</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Sky.Tests\**" />
		<EmbeddedResource Remove="Sky.Tests\**" />
		<None Remove="Sky.Tests\**" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Include="Sky.Tests\Services\Setup\SetupServiceRefactoredTests.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MediatR" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
		<PackageReference Include="Moq" />
		<PackageReference Include="RazorLight" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Common\Cosmos.Common.csproj" />
		<ProjectReference Include="..\Cosmos.BlobService\Cosmos.BlobService.csproj" />
		<ProjectReference Include="..\Cosmos.ConnectionStrings\Cosmos.DynamicConfig.csproj" />
		<ProjectReference Include="..\Editor\Sky.Editor.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Configuration\" />
	  <Folder Include="Features\Articles\CreateVersion\" />
	  <Folder Include="Services\Migrations\TestMigrations\" />
	</ItemGroup>

</Project>
