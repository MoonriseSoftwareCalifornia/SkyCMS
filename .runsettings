<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
	<DataCollectionRunSettings>
		<DataCollectors>
			<DataCollector friendlyName="Code Coverage" uri="datacollector://Microsoft/CodeCoverage/2.0" assemblyQualifiedName="Microsoft.VisualStudio.Coverage.DynamicCoverageDataCollector, Microsoft.VisualStudio.TraceCollector, Version=11.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a">
				<Configuration>
					<CodeCoverage>
						<!-- Exclude migrations and auto-generated files -->
						<ModulePaths>
							<Exclude>
								<ModulePath>.*Tests.dll$</ModulePath>
							</Exclude>
						</ModulePaths>

						<Functions>
							<Exclude>
								<!-- Exclude all migration methods -->
								<Function>.*\.Migrations\..*</Function>
								<Function>.*Migration.*\.Up</Function>
								<Function>.*Migration.*\.Down</Function>
								<Function>.*Migration.*\.BuildTargetModel</Function>
								<!-- Exclude Razor-generated document -->
								<Function>.*AspNetCoreGeneratedDocument.*</Function>
							</Exclude>
						</Functions>

						<Attributes>
							<Exclude>
								<!-- Exclude auto-generated code -->
								<Attribute>^System\.Diagnostics\.DebuggerHiddenAttribute$</Attribute>
								<Attribute>^System\.Diagnostics\.DebuggerNonUserCodeAttribute$</Attribute>
								<Attribute>^System\.Runtime\.CompilerServices\.CompilerGeneratedAttribute$</Attribute>
								<Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
								<Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
							</Exclude>
						</Attributes>
						<Sources>
							<Exclude>
								<!-- Exclude migration folders -->
								<Source>.*\\Migrations\\.*</Source>
								<Source>.*\\obj\\.*</Source>
								<Source>.*\\bin\\.*</Source>
								<!-- Exclude designer and generated files -->
								<Source>.*\.Designer\.cs$</Source>
								<Source>.*\.designer\.cs$</Source>
								<Source>.*\.g\.cs$</Source>
								<Source>.*\.g\.i\.cs$</Source>
								<Source>.*\.Generated\.cs$</Source>
								<Source>.*\.generated\.cs$</Source>
								<!-- Exclude Razor and view files -->
								<Source>.*\.cshtml\.cs$</Source>
								<Source>.*\.razor\.cs$</Source>
								<!-- Exclude AssemblyInfo and other metadata -->
								<Source>.*\\AssemblyInfo\.cs$</Source>
								<Source>.*\\AssemblyAttributes\.cs$</Source>
								<!-- Exclude scaffolded/template files -->
								<Source>.*\\Scaffolding\\.*</Source>
								<Source>.*\\Templates\\.*\.cs$</Source>
								<Source>.*\\Program\.cs$</Source>
								<!-- Often just DI setup -->
								<Source>.*\\Startup\.cs$</Source>
								<!-- DI configuration -->
								<Source>.*\\MultiTenant\.cs$</Source>
								<!-- DI configuration -->
								<Source>.*\\SingleTenant\.cs$</Source>
								<!-- DI configuration -->
								<!-- Exclude ASP.NET Core specific patterns -->
								<Source>.*\\wwwroot\\.*</Source>
								<!-- Static files -->
								<Source>.*DbContext\.cs$</Source>
								<!-- EF Core DbContext model configuration -->
							</Exclude>
						</Sources>
					<!-- Match the company name property in the assembly -->
					<CompanyNames>
						<Exclude>
							<CompanyName>.*microsoft.*</CompanyName>
						</Exclude>
					</CompanyNames>

					<!-- Match the public key token of signed assemblies -->
					<PublicKeyTokens>
						<Exclude>
							<!-- Exclude Visual Studio extensions and Microsoft assemblies -->
							<PublicKeyToken>^B77A5C561934E089$</PublicKeyToken>
							<PublicKeyToken>^B03F5F7F11D50A3A$</PublicKeyToken>
							<PublicKeyToken>^31BF3856AD364E35$</PublicKeyToken>
							<PublicKeyToken>^89845DCD8080CC91$</PublicKeyToken>
							<PublicKeyToken>^71E9BCE111E9429C$</PublicKeyToken>
							<PublicKeyToken>^8F50407C4E9E73B6$</PublicKeyToken>
							<PublicKeyToken>^E361AF139669C375$</PublicKeyToken>
						</Exclude>
					</PublicKeyTokens>
						<!-- Use SymbolSearch to find PDB files -->
						<UseVerifiableInstrumentation>True</UseVerifiableInstrumentation>
						<AllowLowIntegrityProcesses>True</AllowLowIntegrityProcesses>
						<CollectFromChildProcesses>True</CollectFromChildProcesses>
						<CollectAspDotNet>False</CollectAspDotNet>
					</CodeCoverage>
				</Configuration>
			</DataCollector>
		</DataCollectors>
	</DataCollectionRunSettings>
</RunSettings>