<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>annotations</Nullable>
		<AssemblyVersion>12.1.3</AssemblyVersion>
		<FileVersion>12.1.3</FileVersion>
		<Version>12.1.3</Version>
		<Title>Sky CMS Multi-Cloud Storage Provider</Title>
		<Authors>toiyabe62</Authors>
		<Company>Moonrise Software LLC</Company>
		<Description>Multi-cloud blob storage abstraction layer supporting Azure Blob Storage, Amazon S3, and Cloudflare R2. Part of the SkyCMS project.</Description>
		<Copyright>Moonrise Software LLC</Copyright>
		<PackageProjectUrl>https://github.com/CWALabs/SkyCMS/tree/main/Cosmos.BlobService</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReleaseNotes>Updated for .NET 10</PackageReleaseNotes>
		<PackageReadmeFile>NUGET.md</PackageReadmeFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="nuget.config" />
		<None Remove="stylecop.json" />
	</ItemGroup>

	<PropertyGroup>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<PackageIcon>B2C_BrandIcon_Black.png</PackageIcon>
		<RepositoryUrl>https://github.com/CWALabs/SkyCMS</RepositoryUrl>
		<PackageTags>Azure Storage;Azure Blob Storage;Blob Storage;AWS S3;Amazon S3;Cloudflare R2;Multi-Cloud;SkyCMS</PackageTags>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<IncludeSymbols>True</IncludeSymbols>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<ItemGroup>
		<AdditionalFiles Include="stylecop.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AWSSDK.S3" />
		<PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
		<PackageReference Include="Azure.Storage.Files.Shares" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" />
		<PackageReference Include="Roslynator.Analyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="StyleCop.Analyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.Security.Cryptography.Xml" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Cosmos.ConnectionStrings\Cosmos.DynamicConfig.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="B2C_BrandIcon_Black.png">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Update="NUGET.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Update="Readme.md">
			<Pack>False</Pack>
		</None>
	</ItemGroup>

</Project>
