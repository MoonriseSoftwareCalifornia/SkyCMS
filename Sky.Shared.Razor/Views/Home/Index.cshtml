@model Cosmos.Common.Models.ArticleViewModel
@{
    Layout = null;
    ViewData["Title"] = Model.Title;
}
<!DOCTYPE HTML>
<html lang="@Model.LanguageCode">
<head>
    <title>@Model.Title</title>
    <meta property="og:title" content="@Model.Title" />
    <meta property="og:url" content="@Model.OGUrl" />
    <meta property="og:type" content="article" />
    <meta property="og:image" content="@Model.OGImage" />
    <meta property="article:modified_time" content="@Model.Updated.ToString("u")">
    <meta name="cwps-meta-path-url" content="@Model.UrlPath" />
    <meta name="cwps-meta-path-updated" content="@Model.Updated" />
    <meta name="cwps-meta-author-info" content="@Model.AuthorInfo" />
    <meta name="cwps-meta-user-is-authenticated" content="@User.Identity.IsAuthenticated.ToString().ToLower()" />
    @if (Model.ArticleType == Cosmos.Cms.Common.ArticleType.BlogStream)
    {
        <style>
            .sky-blog-stream-container {
                width: 100%;
                padding-right: calc(var(--bs-gutter-x) * .5);
                padding-left: calc(var(--bs-gutter-x) * .5);
                margin-right: auto;
                margin-left: auto;
            }

            .sky-blog-stream-header {
                margin-bottom: 1.5rem !important;
            }

            .sky-blog-stream-heading {
              font-size: calc(1.375rem + 1.5vw);
              font-weight: 500;
              line-height: 1.2;
              margin-bottom: 0.5rem;
            }

            @@media (min-width: 1200px) {
                .sky-blog-stream-heading {
                    font-size: 2.5rem;
                }
            }

            .sky-blog-stream-card-body {
                flex: 1 1 auto;
                padding: 1rem;
            }
        </style>
    }

    @if (Model.ArticleType == Cosmos.Cms.Common.ArticleType.BlogPost)
    {
        <style>
            .sky-blog-post-article {
                padding-top: 3rem !important;
                padding-bottom: 3rem !important;
            }

            .sky-blog-post-container {
                width: 100%;
                padding-right: calc(var(--bs-gutter-x) * .5);
                padding-left: calc(var(--bs-gutter-x) * .5);
                margin-right: auto;
                margin-left: auto;
            }

            .sky-blog-post-header {
                margin-bottom: 1.5rem !important;
            }

            .sky-blog-post-title {
                font-size: calc(1.425rem + 2.1vw);
                font-weight: 300;
                line-height: 1.2;
                font-weight: 700 !important;
            }

            @@media (min-width: 1200px) {
                .sky-blog-post-title {
                    font-size: 3rem;
                }
            }

            .sky-blog-post-info {
                color: rgba(108, 117, 125, 1) !important;
                margin-bottom: 0 !important;
            }

            .sky-blog-post-info-updated {
                /* Using ISO 8601 format for machine-readable datetime */
            }

            .sky-blog-post-header-author {
                /* Author information */
            }

            .sky-blog-post-figure {
                margin-bottom: 1.5rem !important;
            }

            .sky-blog-post-image-div {
                display: inline-block;
                max-width: 100%;
                overflow: hidden;
            }

            .sky-blog-post-image {
                width: 100%;
                height: auto;
                display: block;
            }

            .sky-blog-post-content {
                max-width: 760px;
                margin: 0 auto;
                font-size: 1.1rem;
                line-height: 1.65;
            }
        </style>
    }
    @Html.Raw(Model.Layout.Head)
    <link rel="stylesheet" href="~/lib/ckeditor/ckeditor5-content.css" />
    @Html.Raw(Model.HeadJavaScript)
</head>
<body>
    @Html.Raw(Model.Layout.HtmlHeader)
    @if (Model.ArticleType == Cosmos.Cms.Common.ArticleType.BlogPost)
    {
        @Html.Partial("_BlogPostPartial", Model)
    }
    else
    {
        @Html.Raw(Model.Content)
    }
    @Html.Raw(Model.Layout.FooterHtmlContent)
    @Html.Raw(Model.FooterJavaScript)
</body>
</html>
