@using Cosmos.Common.Models.Blog
@model Cosmos.Common.Models.ArticleViewModel
@{
    var blogPosts = (BlogIndexViewModel?)ViewData["BlogIndexViewModel"] ?? null;
}
<section class="pico" aria-labelledby="blog-heading">
    <header>
        <h1 id="blog-heading">@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Introduction))
        {
            <p>@Model.Introduction</p>
        }
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.BannerImage))
    {
        <figure>
            <img src="@Model.BannerImage" alt="@Model.Title" loading="lazy" decoding="async" />
        </figure>
    }

    <section id="post-list" aria-label="Blog posts">
        @if (blogPosts == null || blogPosts.Posts == null || !blogPosts.Posts.Any())
        {
            <p><em>No blog posts available.</em></p>
        }
        else
        {
            @foreach (var post in blogPosts.Posts ?? Enumerable.Empty<BlogListItem>())
            {
                @Html.Partial("_BlogStreamCard", post)
            }
        }
    </section>

    @Html.Partial("BlogNavPartial", blogPosts)
</section>