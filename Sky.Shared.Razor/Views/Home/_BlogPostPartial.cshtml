@model Cosmos.Common.Models.ArticleViewModel
<article class="sky-blog-post-article" aria-labelledby="post-title">
    <div class="sky-blog-post-container">
        <header class="sky-blog-post-header">
            <h1 id="post-title" class="sky-blog-post-title">@Model.Title</h1>
            <p class="sky-blog-post-info">
                <time class="sky-blog-post-info-updated" datetime="@Model.Updated.UtcDateTime.ToString("O")">@Model.Updated.UtcDateTime.ToString("O")</time>
                @if (!string.IsNullOrWhiteSpace(Model.AuthorInfo))
                {
                    <span class="sky-blog-post-header-author">Model.AuthorInfo</span>
                }
            </p>
        </header>
        @if (!string.IsNullOrWhiteSpace(Model.BannerImage))
        {
            <figure class="sky-blog-post-figure">
                <img src="@Model.BannerImage" alt="@Model.Title" class="sky-blog-post-image">
            </figure>
        }
        <section class="sky-blog-post-content">@Html.Raw(Model.Content)</section>
    </div>
</article>