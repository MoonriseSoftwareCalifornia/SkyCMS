<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Company>Moonrise Software LLC</Company>
		<Version>12.0.1</Version>
		<AssemblyVersion>12.0.1</AssemblyVersion>
		<FileVersion>12.0.1</FileVersion>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<RepositoryUrl>https://github.com/CWALabs/SkyCMS</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>SMTP, SendGrid, Azure Email, Email Provider, Identity, ASP.NET Identity, SkyCMS</PackageTags>
		<Description>Multi-service email provider (SendGrid, SMTP, Azure Communication Services) for ASP.NET Core Identity. Part of the SkyCMS project.</Description>
		<PackageProjectUrl>https://github.com/CWALabs/SkyCMS/tree/main/Cosmos.EmailServices</PackageProjectUrl>
		<PackageReadmeFile>NUGET.md</PackageReadmeFile>
		<PackageReleaseNotes>Documentation dependencies updated.</PackageReleaseNotes>
		<Title>Cosmos CMS Email Services</Title>
		<Copyright>Copyright 2023 (c) Moonrise Software, LLC.</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<Content Remove="stylecop.json" />
		<None Remove="stylecop.json" />
		<AdditionalFiles Include="stylecop.json" />
	</ItemGroup>

	<PropertyGroup>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<PackageIcon>B2C_BrandIcon_Black.png</PackageIcon>
		<IncludeSymbols>True</IncludeSymbols>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="B2C_BrandIcon_Black.png">
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
	  </None>
	  <None Include="NUGET.md">
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
	  </None>
	  <None Include="README.md">
		<Pack>False</Pack>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Azure.Communication.Email" />
	  <PackageReference Include="Azure.Identity" />
	  <PackageReference Include="HtmlAgilityPack" />
	  <PackageReference Include="Roslynator.Analyzers">
		<PrivateAssets>all</PrivateAssets>
		<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="Microsoft.AspNetCore.Identity.UI" />
	  <PackageReference Include="Microsoft.Extensions.Logging" />
	  <PackageReference Include="SendGrid" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\AspNetCore.Identity.FlexDb\AspNetCore.Identity.FlexDb.csproj" />
	  <ProjectReference Include="..\Common\Cosmos.Common.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Templates\EmailTemplates.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>EmailTemplates.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Templates\EmailTemplates.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>EmailTemplates.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="README.md">
			<Pack>False</Pack>
		</None>
	</ItemGroup>

</Project>
